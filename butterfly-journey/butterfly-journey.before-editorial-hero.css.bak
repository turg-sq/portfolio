.butterfly-journey-page{position:fixed;z-index:20;inset:0;overflow:auto;min-height:100svh;background:#100605;color:#f3e6cf;font-family:var(--font-body-cn)}.butterfly-journey-page__back{position:fixed;z-index:200;top:24px;left:24px;display:inline-flex;align-items:center;gap:9px;min-height:46px;padding:0 18px;border:0;border-radius:999px;background:rgba(14,7,7,.88);color:#fff;font:600 15px/1 var(--font-body-cn);cursor:pointer;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transition:background .18s ease-out,transform .18s ease-out}.butterfly-journey-page__back>span{transition:transform .18s ease-out}.butterfly-journey-page__back:hover{background:rgba(56,21,20,.94)}.butterfly-journey-page__back:hover>span{transform:translateX(-2px)}.butterfly-journey-page__back:active{transform:scale(.97)}.butterfly-journey-page__back:focus-visible{outline:3px solid rgba(225,185,105,.65);outline-offset:4px}.butterfly-journey-page__header{width:min(1440px,calc(100vw - 64px));margin:0 auto;padding:120px 0 48px}.butterfly-journey-page__header p{margin:0 0 22px;color:#b59a6b;font-size:12px;letter-spacing:.14em}.butterfly-journey-page__header span{display:block;color:#c9b98d;font-size:12px;letter-spacing:.15em}.butterfly-journey-page__header h1{margin:14px 0 12px;font-family:var(--font-display-cn);font-size:clamp(52px,8vw,124px);font-weight:400;line-height:.96;letter-spacing:-.045em}.butterfly-journey-page__header strong{font-size:clamp(16px,1.7vw,24px);font-weight:500;color:#dacba9}.butterfly-journey-page__gallery{width:min(1440px,calc(100vw - 64px));margin:0 auto;display:flex;flex-direction:column;gap:28px;padding-bottom:80px}.butterfly-journey-page__gallery figure{margin:0}.butterfly-journey-page__gallery img{display:block;width:100%;height:auto;border-radius:15px;object-fit:contain}@media(max-width:767px){.butterfly-journey-page__back{top:max(14px,env(safe-area-inset-top));left:14px;min-height:44px;padding:0 16px}.butterfly-journey-page__header{width:calc(100vw - 24px);padding:98px 0 34px}.butterfly-journey-page__gallery{width:calc(100vw - 24px);gap:16px;padding-bottom:44px}.butterfly-journey-page__header h1{font-size:clamp(46px,15vw,72px)}}
