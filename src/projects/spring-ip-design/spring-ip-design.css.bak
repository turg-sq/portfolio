.spring-ip-page{--tomato:#e94532;--sky:#4baeeb;--grass:#68a748;--cream:#f5f3e8;--yellow:#f5d74b;position:fixed;z-index:20;inset:0;overflow:auto;background:var(--cream);color:#172321;font-family:var(--font-body-cn)}.spring-ip-page *{box-sizing:border-box}.spring-ip-container{width:min(1440px,calc(100vw - 96px));margin-inline:auto}.spring-ip-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px}.spring-ip-page__back{position:fixed;z-index:50;top:24px;left:24px;display:inline-flex;align-items:center;gap:9px;min-height:46px;padding:0 18px;border:0;border-radius:999px;background:rgba(18,31,29,.88);color:#fff;font:600 15px/1 var(--font-body-cn);cursor:pointer;backdrop-filter:blur(10px);transition:background .18s ease-out,transform .18s ease-out}.spring-ip-page__back:hover{background:var(--tomato)}.spring-ip-page__back:hover>span{transform:translateX(-2px)}.spring-ip-page__back>span{transition:transform .18s ease-out}.spring-ip-page__back:active{transform:scale(.97)}.spring-ip-page__back:focus-visible,.spring-ip-hero__arrow:focus-visible,.spring-ip-next:focus-visible{outline:3px solid var(--yellow);outline-offset:4px}
.spring-ip-hero{position:relative;min-height:100svh;overflow:hidden;background:#163d70}.spring-ip-hero__slide{position:absolute;inset:0;display:grid;align-items:end;overflow:hidden}.spring-ip-hero__background{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.spring-ip-hero__slide.is-keyvisual{display:grid;place-items:center;padding:96px clamp(48px,8vw,136px) 82px;background:#87949a}.spring-ip-hero__slide.is-keyvisual .spring-ip-hero__background{position:relative;inset:auto;width:min(76vw,1240px);height:auto;max-height:68svh;object-fit:contain;filter:brightness(.76) saturate(.88)}.spring-ip-hero__blue{position:absolute;inset:0;background:linear-gradient(135deg,#53bced,#15569f)}.spring-ip-hero__phones{position:absolute;left:50%;bottom:-5%;width:min(82vw,1220px);height:auto;transform:translateX(-50%);object-fit:contain;filter:drop-shadow(0 34px 30px rgba(8,39,88,.28))}.spring-ip-hero__shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(8,16,29,.52),transparent 42%)}.spring-ip-hero__slide.is-keyvisual .spring-ip-hero__shade{background:linear-gradient(180deg,rgba(255,255,255,.1),rgba(15,20,22,.25))}.spring-ip-hero__dot-grid{position:absolute;z-index:1;inset:0;background-image:radial-gradient(circle,rgba(36,43,45,.68) 1.25px,transparent 1.6px);background-size:8px 8px;opacity:.58;pointer-events:none}.spring-ip-hero__center-mark{position:absolute;z-index:3;left:50%;top:50%;padding:.08em .22em;color:#fff;font-family:var(--font-display-cn);font-size:clamp(42px,5.2vw,90px);font-weight:400;line-height:1;letter-spacing:.14em;text-shadow:0 4px 22px rgba(0,0,0,.28);transform:translate(-50%,-50%);white-space:nowrap}.spring-ip-hero__copy{position:relative;z-index:2;width:min(1440px,calc(100vw - 96px));margin:0 auto;padding:0 0 76px;color:#fff}.spring-ip-hero__copy p{margin:0;font-size:12px;font-weight:700;line-height:1.45;letter-spacing:.14em}.spring-ip-hero__copy h1{display:grid;margin:18px 0 0;font-family:var(--font-display-cn);font-size:clamp(56px,7vw,116px);font-weight:400;line-height:1.02;letter-spacing:.04em}.spring-ip-hero__copy strong{display:block;margin-top:18px;font-size:15px;font-weight:600;letter-spacing:.09em}.spring-ip-hero__slide.is-keyvisual .spring-ip-hero__copy{z-index:4}.spring-ip-hero__arrow{position:absolute;z-index:5;top:50%;display:grid;width:52px;height:52px;place-items:center;border:1px solid rgba(255,255,255,.36);border-radius:50%;background:rgba(255,255,255,.16);color:#fff;font-size:22px;cursor:pointer;backdrop-filter:blur(12px);transform:translateY(-50%);transition:background .18s ease-out,transform .18s ease-out}.spring-ip-hero__arrow:hover{background:rgba(255,255,255,.3)}.spring-ip-hero__arrow:active{transform:translateY(-50%) scale(.96)}.spring-ip-hero__arrow.is-prev{left:32px}.spring-ip-hero__arrow.is-next{right:32px}.spring-ip-hero__progress{position:absolute;z-index:5;right:48px;bottom:42px;display:flex;align-items:center;gap:16px;color:#fff;font:700 12px/1 var(--font-body-cn);letter-spacing:.12em}.spring-ip-hero__progress i{width:94px;height:1px;background:rgba(255,255,255,.38)}.spring-ip-hero__progress b{display:block;width:100%;height:100%;background:#fff;transform-origin:left;transition:transform .7s cubic-bezier(.22,1,.36,1)}
.spring-ip-section{padding-block:120px}.spring-ip-heading{display:grid;grid-template-columns:84px minmax(0,1fr);gap:28px;margin-bottom:48px}.spring-ip-heading>span,.spring-ip-heading p{margin:0;color:var(--tomato);font:700 12px/1.3 var(--font-body-cn);letter-spacing:.14em}.spring-ip-heading h2{max-width:760px;margin:13px 0 0;font-family:var(--font-display-cn);font-size:clamp(52px,6vw,104px);font-weight:400;line-height:1.02;letter-spacing:.04em}.spring-ip-heading.is-inverse>span,.spring-ip-heading.is-inverse p{color:#f2d77c}.spring-ip-heading.is-inverse h2{color:#fff}.spring-ip-image{min-width:0;margin:0;overflow:hidden;border-radius:20px}.spring-ip-image img{display:block;width:100%;height:auto;object-fit:contain;border-radius:20px}
.spring-ip-character{background:#f4f5e9}.spring-ip-character__copy{grid-column:1 / span 5;align-self:center}.spring-ip-character__copy>p{max-width:620px;margin:0;font-size:18px;line-height:1.8}.spring-ip-character__tags,.spring-ip-h5__tags{display:flex;flex-wrap:wrap;gap:9px;margin-top:28px}.spring-ip-character__tags span,.spring-ip-h5__tags span{padding:9px 12px;border-radius:999px;background:#fff;color:#315f3b;font-size:12px;font-weight:700;letter-spacing:.06em}.spring-ip-character__image{grid-column:6 / span 7;justify-self:center;width:clamp(420px,46vw,720px);max-width:100%;height:auto;filter:drop-shadow(0 28px 24px rgba(61,96,45,.17));cursor:default}
.spring-ip-campaign{position:relative;overflow:hidden;background:#fff}.spring-ip-campaign__display{position:relative}.spring-ip-campaign__display>b{position:absolute;z-index:0;top:-.24em;left:-.04em;color:rgba(233,69,50,.1);font-family:var(--font-display-cn);font-size:clamp(88px,15vw,260px);font-weight:400;line-height:.75;letter-spacing:.02em;pointer-events:none}.spring-ip-campaign__display .spring-ip-image{position:relative;z-index:1}.spring-ip-world{background:#f6f7ef}.spring-ip-world__main{grid-column:1 / span 7}.spring-ip-world__side{grid-column:8 / span 5;padding-top:80px}.spring-ip-world__side .spring-ip-heading{grid-template-columns:1fr;gap:0;margin-bottom:28px}.spring-ip-world__side>p{max-width:34em;margin:0 0 32px;font-size:17px;line-height:1.8}
.spring-ip-h5{min-height:100svh;display:grid;align-items:center;background:linear-gradient(135deg,#1676c9,#67b8f1);color:#fff}.spring-ip-h5__copy{grid-column:1 / span 4;align-self:center}.spring-ip-h5 .spring-ip-heading>span,.spring-ip-h5 .spring-ip-heading p{color:#d9f3ff}.spring-ip-h5 .spring-ip-heading h2{color:#fff}.spring-ip-h5__copy>p{max-width:31em;margin:0;font-size:18px;line-height:1.8}.spring-ip-h5__tags span{background:rgba(255,255,255,.16);color:#fff}.spring-ip-h5__visual{position:relative;grid-column:5 / span 8;margin:0}.spring-ip-h5__visual:after{content:'';position:absolute;z-index:0;left:14%;right:14%;bottom:8%;height:8%;border-radius:50%;background:rgba(16,67,133,.24);filter:blur(18px)}.spring-ip-h5__visual img{position:relative;z-index:1;display:block;width:clamp(520px,52vw,860px);max-width:100%;height:auto;object-fit:contain}
.spring-ip-motion{background:#101315;color:#fff}.spring-ip-motion__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.spring-ip-motion__grid .spring-ip-image{padding:14px;background:#f4f3ed}.spring-ip-motion__grid img{border-radius:10px}.spring-ip-motion__captions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:16px;color:#e7e4db;font-size:14px;font-weight:700;letter-spacing:.07em}
.spring-ip-gallery{background:#f8f1d7;overflow:hidden}.spring-ip-gallery__track{display:flex;gap:24px;overflow-x:auto;padding:0 0 16px;cursor:grab;scrollbar-width:thin;touch-action:pan-y}.spring-ip-gallery__track:active{cursor:grabbing}.spring-ip-gallery__track figure{flex:0 0 clamp(360px,32vw,520px);display:grid;place-items:center;min-height:330px;margin:0;padding:20px;border-radius:20px;background:#fffdf5;overflow:hidden;transition:transform .42s cubic-bezier(.22,1,.36,1)}.spring-ip-gallery__track figure:hover{transform:scale(.985)}.spring-ip-gallery__track img{display:block;width:100%;height:auto;max-height:460px;object-fit:contain;transition:transform .42s cubic-bezier(.22,1,.36,1)}.spring-ip-gallery__track figure:hover img{transform:scale(1.035)}
.spring-ip-summary{background:#f4f5e9}.spring-ip-summary>div>div{grid-column:1 / span 7}.spring-ip-summary>div>div>p{max-width:620px;margin:0;font-size:18px;line-height:1.8}.spring-ip-summary dl{grid-column:9 / span 4;display:grid;gap:22px;margin:0;align-content:start;padding-top:112px}.spring-ip-summary dl div{padding-top:14px;border-top:1px solid rgba(23,35,33,.18)}.spring-ip-summary dt{color:#58725c;font-size:11px;font-weight:700;letter-spacing:.13em}.spring-ip-summary dd{margin:7px 0 0;font-size:15px;line-height:1.55}.spring-ip-next{display:grid;gap:13px;width:100%;padding:120px max(48px,calc((100vw - 1440px) / 2 + 48px));border:0;background:var(--tomato);color:#fff;text-align:left;cursor:pointer;transition:background .24s ease-out}.spring-ip-next:hover{background:#d83b2c}.spring-ip-next span{font-size:12px;font-weight:700;letter-spacing:.14em}.spring-ip-next strong{font-family:var(--font-display-cn);font-size:clamp(42px,6vw,96px);font-weight:400;line-height:1.04;letter-spacing:.04em}.spring-ip-next em{font-size:15px;font-style:normal;transition:transform .24s ease-out}.spring-ip-next:hover em{transform:translateX(8px)}
@media(max-width:899px){.spring-ip-container,.spring-ip-hero__copy{width:calc(100vw - 32px)}.spring-ip-page__back{top:max(14px,env(safe-area-inset-top));left:14px;min-height:44px;padding:0 16px}.spring-ip-hero__copy{padding-bottom:54px}.spring-ip-hero__slide.is-keyvisual{padding:84px 24px 74px}.spring-ip-hero__slide.is-keyvisual .spring-ip-hero__background{width:min(100%,740px);max-height:60svh}.spring-ip-hero__center-mark{font-size:clamp(38px,12vw,68px)}.spring-ip-hero__phones{width:125vw;bottom:8%}.spring-ip-hero__arrow{top:auto;bottom:46px;width:46px;height:46px}.spring-ip-hero__arrow.is-prev{left:auto;right:76px}.spring-ip-hero__arrow.is-next{right:18px}.spring-ip-hero__progress{right:136px;bottom:64px}.spring-ip-hero__progress i{width:56px}.spring-ip-section{padding-block:72px}.spring-ip-grid{grid-template-columns:1fr;gap:32px}.spring-ip-heading{grid-template-columns:1fr;gap:13px;margin-bottom:32px}.spring-ip-heading h2{font-size:clamp(48px,14vw,72px)}.spring-ip-character__copy,.spring-ip-character__image,.spring-ip-world__main,.spring-ip-world__side,.spring-ip-h5__copy,.spring-ip-h5__visual,.spring-ip-summary>div>div,.spring-ip-summary dl{grid-column:auto}.spring-ip-character__image{width:min(100%,620px);order:2}.spring-ip-world__side{padding-top:0}.spring-ip-h5{min-height:auto}.spring-ip-h5__visual img{width:100%}.spring-ip-motion__grid,.spring-ip-motion__captions{grid-template-columns:1fr;gap:16px}.spring-ip-motion__captions{margin-top:14px}.spring-ip-gallery__track{margin-right:-16px}.spring-ip-gallery__track figure{flex-basis:min(82vw,480px);min-height:280px}.spring-ip-summary dl{padding-top:0}.spring-ip-next{padding:72px 16px}}

/* Hero slides share one full-bleed visual system. */
.spring-ip-hero{width:100%;height:100vh;min-height:100svh}
.spring-ip-hero__slide{width:100%;height:100%;display:block}
.spring-ip-hero__slide::after{content:'';position:absolute;z-index:3;inset:0;background-image:radial-gradient(circle,rgba(50,55,55,.5) 1.7px,transparent 1.8px);background-size:11px 11px;pointer-events:none}
.spring-ip-hero__background{position:absolute!important;z-index:0;inset:0!important;width:100%!important;height:100%!important;max-width:none!important;max-height:none!important;margin:0!important;padding:0!important;border-radius:0!important;object-fit:cover!important;object-position:center center;filter:none!important;transform-origin:center center}
.spring-ip-hero__slide.is-keyvisual{display:block;padding:0;background:#163d70}
.spring-ip-hero__slide.is-keyvisual .spring-ip-hero__background{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;max-width:none!important;max-height:none!important;object-fit:cover!important;filter:none!important}
.spring-ip-hero__blue{z-index:0;background:linear-gradient(180deg,#4eb1df 0%,#318fc9 48%,#174d7a 100%)}
.spring-ip-hero__shade{z-index:1;background:linear-gradient(to top,rgba(8,16,29,.32),transparent 42%)}
.spring-ip-hero__slide.is-keyvisual .spring-ip-hero__shade{background:linear-gradient(to top,rgba(8,16,29,.28),transparent 42%)}
.spring-ip-hero__phones-stage{position:absolute;z-index:2;left:50%;top:50%;display:flex;align-items:center;justify-content:center;transform:translate(-50%,-50%)}
.spring-ip-hero__phones{position:relative;left:auto;top:auto;bottom:auto;width:clamp(460px,38vw,720px);transform:none;transform-origin:center center}
.spring-ip-hero__dot-grid{display:none}
.spring-ip-hero__center-mark{z-index:5}
.spring-ip-hero__copy{position:absolute;z-index:5;left:clamp(32px,4vw,72px);bottom:clamp(56px,8vh,110px);width:auto;margin:0;padding:0}
.spring-ip-hero__arrow,.spring-ip-hero__progress{z-index:10}

@media(max-width:899px){
  .spring-ip-hero__copy{width:auto;padding:0}
  .spring-ip-hero__slide.is-keyvisual{padding:0}
  .spring-ip-hero__slide.is-keyvisual .spring-ip-hero__background{width:100%!important;height:100%!important;max-height:none!important}
  .spring-ip-hero__phones-stage{top:48%}
  .spring-ip-hero__phones{width:min(78vw,520px)}
  .spring-ip-hero__slide::after{background-image:radial-gradient(circle,rgba(50,55,55,.5) 1.4px,transparent 1.5px);background-size:9px 9px}
}

/* Unified image rhythm and new project-detail chapters. */
.spring-ip-world{background:#f6f7ef}.spring-ip-world__main,.spring-ip-world__secondary{grid-column:span 7}.spring-ip-world__side{grid-column:8 / span 5;align-self:center;padding-top:0}.spring-ip-world__side .spring-ip-heading{grid-template-columns:1fr;gap:0;margin-bottom:28px}.spring-ip-world__side>p,.spring-ip-world__note p{max-width:34em;margin:0;font-size:17px;line-height:1.8}.spring-ip-world__note{grid-column:1 / span 5;align-self:center}.spring-ip-world__secondary{grid-column:6 / span 7}.spring-ip-world .spring-ip-image{width:100%;border-radius:28px}.spring-ip-world .spring-ip-image img{width:100%;border-radius:28px}

.spring-ip-h5{position:relative;isolation:isolate;overflow:hidden}.spring-ip-h5:before{content:'';position:absolute;z-index:0;inset:0;background-image:radial-gradient(circle,rgba(48,59,64,.48) 1.35px,transparent 1.55px);background-size:10px 10px;opacity:.5;pointer-events:none}.spring-ip-h5 .spring-ip-container{position:relative;z-index:1}.spring-ip-h5__copy{grid-column:1 / span 3}.spring-ip-h5__visual{grid-column:4 / span 9;display:grid;place-items:center;justify-self:center;width:100%;margin:0}.spring-ip-h5__visual img{width:clamp(720px,60vw,1040px);max-width:113%;height:auto;object-fit:contain}.spring-ip-h5__visual:after{left:12%;right:12%;bottom:7%;height:9%}

.spring-ip-ip-system{background:#fffdf5}.spring-ip-ip-system__intro{max-width:660px;margin:-10px 0 48px 112px;font-size:18px;line-height:1.8}.spring-ip-ip-system__grid{align-items:start}.spring-ip-ip-system__grid>.is-primary{grid-column:1 / span 7;background:linear-gradient(145deg,#e3f2f7,#f8f3dc);display:grid;place-items:center;min-height:620px}.spring-ip-ip-system__grid>.is-primary img{width:min(86%,720px);max-height:620px;object-fit:contain}.spring-ip-ip-system__support{grid-column:8 / span 5;display:grid;gap:24px}.spring-ip-ip-system__support .spring-ip-image{min-height:298px;background:#f1eee6;display:grid;place-items:center}.spring-ip-ip-system__support .spring-ip-image:first-child{background:#eef6eb}.spring-ip-ip-system__support img{width:100%;height:auto;max-height:360px;object-fit:contain}

.spring-ip-poster{background:#eaf2f4}.spring-ip-poster__copy{grid-column:1 / span 4;align-self:center}.spring-ip-poster__copy .spring-ip-heading{grid-template-columns:1fr;gap:0}.spring-ip-poster__copy p{max-width:32em;margin:0;font-size:17px;line-height:1.8}.spring-ip-poster__main{grid-column:6 / span 4;align-self:start;background:#e6e1d7}.spring-ip-poster__main img{width:100%;height:auto;object-fit:contain}.spring-ip-poster__support{grid-column:10 / span 3;align-self:end;background:#18282e}.spring-ip-poster__support img{width:100%;height:auto;object-fit:contain}

@media(max-width:899px){
  .spring-ip-world__main,.spring-ip-world__secondary,.spring-ip-world__side,.spring-ip-world__note,.spring-ip-h5__copy,.spring-ip-h5__visual,.spring-ip-ip-system__grid>.is-primary,.spring-ip-ip-system__support,.spring-ip-poster__copy,.spring-ip-poster__main,.spring-ip-poster__support{grid-column:auto}
  .spring-ip-world__main,.spring-ip-world__secondary{width:100%}.spring-ip-world__note{order:3}.spring-ip-world__secondary{order:4}.spring-ip-world .spring-ip-image{border-radius:20px}.spring-ip-world .spring-ip-image img{border-radius:20px}
  .spring-ip-h5__visual img{width:100%;max-width:100%}.spring-ip-h5__copy{max-width:34em}.spring-ip-h5:before{background-size:9px 9px}
  .spring-ip-ip-system__intro{margin:-8px 0 32px;font-size:16px}.spring-ip-ip-system__grid>.is-primary{min-height:0}.spring-ip-ip-system__grid>.is-primary img{max-height:none}.spring-ip-ip-system__support{gap:20px}.spring-ip-ip-system__support .spring-ip-image{min-height:0}.spring-ip-ip-system__support img{max-height:none}
  .spring-ip-poster__copy .spring-ip-heading{margin-bottom:26px}.spring-ip-poster__main,.spring-ip-poster__support{justify-self:center;width:min(100%,520px)}
}

/* H5 hero: the phones occupy the viewport center, independent from the copy. */
.spring-ip-hero__phones-stage{width:100%;height:100%;pointer-events:none}.spring-ip-hero__phones{width:clamp(800px,55vw,1080px);max-width:none}

/* Desktop headings protect complete Chinese phrases from awkward character wrapping. */
@media(min-width:900px){.spring-ip-heading h2{width:fit-content;max-width:none;font-size:clamp(52px,5vw,92px);line-height:.95;letter-spacing:.035em;white-space:nowrap}}

/* One centered campaign visual replaces the previously repeated pair of spring KV images. */
.spring-ip-world .spring-ip-container{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px}.spring-ip-world .spring-ip-heading{grid-column:1 / -1}.spring-ip-world__copy{grid-column:2 / span 8;max-width:680px;margin:-16px 0 48px;font-size:18px;line-height:1.8}.spring-ip-world__main{grid-column:2 / span 10;width:100%;margin:0}.spring-ip-world .spring-ip-image,.spring-ip-world .spring-ip-image img{border-radius:28px}

/* Editorial character archive, with one hero character and a compact annotation index. */
.spring-ip-ip-system{position:relative;overflow:hidden;background:#f8f1d7}.spring-ip-ip-system:before{content:'CHARACTER\A ARCHIVE';position:absolute;z-index:0;top:2%;right:-1%;color:rgba(30,48,45,.035);font-family:var(--font-display-cn);font-size:clamp(140px,18vw,300px);font-weight:700;line-height:.78;letter-spacing:.02em;white-space:pre;pointer-events:none}.spring-ip-ip-system .spring-ip-container{position:relative;z-index:1}.spring-ip-ip-system__heading{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:64px}.spring-ip-ip-system__heading .spring-ip-heading{margin-bottom:0}.spring-ip-ip-system__heading>p{margin:0;color:#4f6654;font-size:12px;font-weight:700;line-height:1.7;letter-spacing:.1em;text-align:right}.spring-ip-ip-system__grid{align-items:stretch;row-gap:24px}.spring-ip-ip-system__grid>.is-primary{grid-column:1 / span 5;min-height:600px;background:#f3f2e5}.spring-ip-ip-system__grid>.is-map{grid-column:6 / span 3;min-height:430px;background:#e8f0ed}.spring-ip-ip-system__grid>.is-expression{grid-column:9 / span 4;min-height:430px;background:#f8e9d2}.spring-ip-ip-system__grid>.spring-ip-image{display:grid;place-items:center;overflow:hidden;border-radius:24px;transition:transform .42s cubic-bezier(.22,1,.36,1)}.spring-ip-ip-system__grid>.spring-ip-image img{width:100%;height:100%;object-fit:contain;transition:transform .42s cubic-bezier(.22,1,.36,1)}.spring-ip-ip-system__grid>.is-primary img{width:92%;height:92%}.spring-ip-ip-system__grid>.is-map img,.spring-ip-ip-system__grid>.is-expression img{width:100%;height:100%}.spring-ip-ip-system__grid>.spring-ip-image:hover{transform:scale(.985)}.spring-ip-ip-system__grid>.spring-ip-image:hover img{transform:translateY(-6px) scale(1.035)}.spring-ip-ip-system__notes{grid-column:6 / span 7;align-self:end;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;padding:12px 0 0}.spring-ip-ip-system__notes>p{grid-column:1 / -1;margin:0 0 16px;color:#53695b;font-size:12px;font-weight:700;letter-spacing:.14em}.spring-ip-ip-system__notes ol{grid-column:1 / -1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;margin:0;padding:0;list-style:none}.spring-ip-ip-system__notes li{display:flex;gap:14px;padding:14px 0;border-top:1px solid rgba(23,35,33,.2);font-size:15px;line-height:1.4}.spring-ip-ip-system__notes li span{color:var(--tomato);font-weight:700;font-size:12px;letter-spacing:.08em}

@media(max-width:899px){.spring-ip-hero__phones{width:min(118vw,740px)}.spring-ip-world .spring-ip-container{display:block}.spring-ip-world__copy{margin:-8px 0 32px;font-size:16px}.spring-ip-world__main{width:100%}.spring-ip-world .spring-ip-image,.spring-ip-world .spring-ip-image img{border-radius:24px}.spring-ip-ip-system:before{font-size:36vw;top:3%;right:-8%}.spring-ip-ip-system__heading{display:block;margin-bottom:32px}.spring-ip-ip-system__heading>p{margin-top:18px;text-align:left}.spring-ip-ip-system__grid{display:grid;grid-template-columns:1fr;gap:20px}.spring-ip-ip-system__grid>.is-primary,.spring-ip-ip-system__grid>.is-map,.spring-ip-ip-system__grid>.is-expression,.spring-ip-ip-system__notes{grid-column:auto}.spring-ip-ip-system__grid>.is-primary{min-height:440px}.spring-ip-ip-system__grid>.is-map,.spring-ip-ip-system__grid>.is-expression{min-height:340px}.spring-ip-ip-system__notes{padding-top:12px}.spring-ip-ip-system__notes ol{grid-template-columns:1fr}.spring-ip-ip-system__notes li{font-size:14px}.spring-ip-heading h2{white-space:normal;line-height:1.02}}

/* Spring scenes use a deliberate hero/support pair instead of a single isolated visual. */
.spring-ip-world__scene-pair{grid-column:2 / span 10;display:grid;grid-template-columns:minmax(0,1.28fr) minmax(0,.72fr);align-items:end;gap:clamp(22px,4vw,64px);margin:0}
.spring-ip-world__scene-pair .spring-ip-image{width:100%;margin:0;border-radius:28px;box-shadow:0 22px 46px rgba(28,43,29,.12)}
.spring-ip-world__scene-pair .spring-ip-image img{width:100%;border-radius:28px}
.spring-ip-world__scene-main{align-self:start}
.spring-ip-world__scene-support{align-self:end;margin-bottom:clamp(16px,4vw,72px)!important}
.spring-ip-world__scene-support img{aspect-ratio:1.6 / 1;object-fit:cover!important}

/* The third slide now presents the supplied spring scene as its full visual, not a phone mock-up. */
.spring-ip-hero__slide.is-scene{background:#6a8c47}
.spring-ip-hero__slide.is-scene .spring-ip-hero__background{object-position:center center}
.spring-ip-hero__slide.is-scene .spring-ip-hero__shade{background:linear-gradient(to top,rgba(13,29,22,.5),rgba(13,29,22,.04) 62%)}

@media(max-width:899px){
  .spring-ip-world__scene-pair{display:grid;grid-template-columns:1fr;gap:20px;margin:0}
  .spring-ip-world__scene-support{margin:0!important}
  .spring-ip-world__scene-pair .spring-ip-image,.spring-ip-world__scene-pair .spring-ip-image img{border-radius:22px}
}

/* Layout refinement: matching scene cards and a protected H5 copy column. */
@media(min-width:900px){
  .spring-ip-world__scene-pair{grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(28px,3.5vw,56px);align-items:stretch}
  .spring-ip-world__scene-pair .spring-ip-image{height:clamp(330px,28vw,470px);margin:0!important;border-radius:28px}
  .spring-ip-world__scene-pair .spring-ip-image img{width:100%;height:100%;object-fit:cover!important;border-radius:28px}

  .spring-ip-h5 .spring-ip-container{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:clamp(28px,4vw,64px);align-items:center}
  .spring-ip-h5__copy{grid-column:1 / span 5;position:relative;z-index:2;min-width:0;padding:clamp(16px,2vw,32px) 0}
  .spring-ip-h5__copy .spring-ip-heading{margin-bottom:34px}
  .spring-ip-h5__copy>p{max-width:31em;margin:0;font-size:17px;line-height:1.85}
  .spring-ip-h5__visual{grid-column:6 / span 7;justify-self:stretch;width:100%;max-width:980px;margin:0;overflow:hidden;border-radius:24px;box-shadow:0 24px 58px rgba(9,48,98,.24)}
  .spring-ip-h5__visual img{display:block;width:100%;max-width:none;height:auto;aspect-ratio:4 / 3;object-fit:cover;border-radius:24px}
  .spring-ip-h5__visual:after{display:none}
}

@media(max-width:899px){
  .spring-ip-world__scene-pair .spring-ip-image{width:100%;aspect-ratio:4 / 3;margin:0!important}
  .spring-ip-world__scene-pair .spring-ip-image img{width:100%;height:100%;object-fit:cover!important}
  .spring-ip-h5 .spring-ip-container{display:grid;grid-template-columns:1fr;gap:34px}
  .spring-ip-h5__copy,.spring-ip-h5__visual{grid-column:auto;width:100%;min-width:0}
  .spring-ip-h5__visual{overflow:hidden;border-radius:22px;box-shadow:0 18px 42px rgba(9,48,98,.2)}
  .spring-ip-h5__visual img{display:block;width:100%;height:auto;aspect-ratio:4 / 3;object-fit:cover;border-radius:22px}
  .spring-ip-h5__visual:after{display:none}
}

/* Scroll narrative: Hero hands its energy to character, then to the campaign world. */
.spring-ip-campaign,.spring-ip-world{display:none}
.spring-ip-scroll-story{position:relative;height:145svh;background:linear-gradient(180deg,#f5f3e8 0%,#eff4dc 58%,#f5f3e8 100%);overflow:clip}
.spring-ip-scroll-story__stage{position:sticky;top:0;height:100svh;overflow:hidden;isolation:isolate}
.spring-ip-scroll-story__grid{position:relative;z-index:5;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;width:min(1440px,calc(100vw - 96px));height:100%;margin-inline:auto;pointer-events:none}
.spring-ip-scroll-story__shape{position:absolute;z-index:1;border-radius:50%;pointer-events:none}
.spring-ip-scroll-story__shape.is-tomato{right:-12vw;bottom:-18vh;width:min(54vw,920px);aspect-ratio:1;background:radial-gradient(circle at 34% 30%,#ff735e 0%,#f45a42 36%,#f04432 72%,#d93427 100%)}
.spring-ip-scroll-story__shape.is-cream{left:-6vw;top:14vh;width:min(22vw,380px);aspect-ratio:1;background:#f3d96a;border-radius:46% 54% 48% 52% / 55% 42% 58% 45%}
.spring-ip-scroll-story__copy{grid-column:1 / span 5;align-self:center;color:#172321}
.spring-ip-scroll-story__copy p,.spring-ip-scroll-story__campaign-copy p{margin:0;color:#d84735;font-size:12px;font-weight:700;letter-spacing:.16em}.spring-ip-scroll-story__copy h2{margin:18px 0 20px;font-family:var(--font-display-cn);font-size:clamp(64px,7vw,112px);font-weight:400;line-height:.98;letter-spacing:.03em}.spring-ip-scroll-story__copy span{font-size:18px;line-height:1.75}
.spring-ip-scroll-story__character{position:absolute;z-index:3;right:9vw;bottom:7vh;width:auto;max-width:42vw;max-height:70vh;object-fit:contain;transform-origin:bottom center;pointer-events:none;filter:drop-shadow(0 26px 28px rgba(48,81,34,.18))}
.spring-ip-scroll-story__campaign{position:absolute;z-index:2;right:4vw;bottom:6vh;width:min(52vw,820px);margin:0;overflow:hidden;border-radius:28px;box-shadow:0 30px 70px rgba(44,75,33,.16);transform-origin:bottom right}.spring-ip-scroll-story__campaign img{display:block;width:100%;height:auto;object-fit:contain}
.spring-ip-scroll-story__campaign-copy{position:absolute;z-index:5;left:max(48px,calc((100vw - 1440px)/2 + 48px));bottom:12vh;color:#172321;pointer-events:none}.spring-ip-scroll-story__campaign-copy span{display:block;margin-top:16px;color:#d84735;font-size:13px;font-weight:700;letter-spacing:.16em}.spring-ip-scroll-story__campaign-copy h2{margin:14px 0 0;font-family:var(--font-display-cn);font-size:clamp(48px,5vw,88px);font-weight:400;line-height:1;letter-spacing:.03em;white-space:nowrap}

@media(max-width:899px){
  .spring-ip-scroll-story{height:auto;padding:88px 16px;background:#f5f3e8;overflow:hidden}.spring-ip-scroll-story__stage{position:relative;height:auto;min-height:0;display:grid;gap:36px;overflow:visible}.spring-ip-scroll-story__grid{display:block;width:100%;height:auto;margin:0}.spring-ip-scroll-story__shape{display:none}.spring-ip-scroll-story__copy{position:relative;opacity:1!important;transform:none!important}.spring-ip-scroll-story__copy h2{font-size:clamp(52px,14vw,72px)}.spring-ip-scroll-story__copy span{font-size:16px}.spring-ip-scroll-story__character{position:relative;right:auto;bottom:auto;justify-self:center;width:auto;max-width:90%;max-height:52vh;margin-inline:auto;opacity:1!important;transform:none!important}.spring-ip-scroll-story__campaign{position:relative;right:auto;bottom:auto;width:100%;border-radius:24px;opacity:1!important;transform:none!important}.spring-ip-scroll-story__campaign-copy{position:relative;left:auto;bottom:auto;opacity:1!important;transform:none!important}.spring-ip-scroll-story__campaign-copy h2{font-size:clamp(44px,11vw,62px);white-space:normal}
}

/* Safe baseline: this story must read as a complete Character section before motion starts. */
@media(min-width:900px){
  .spring-ip-scroll-story__copy{padding-bottom:18vh}
  .spring-ip-scroll-story__campaign-copy{left:max(48px,calc((100vw - 1440px)/2 + 48px));bottom:10vh}
}

@media(prefers-reduced-motion:reduce){.spring-ip-scroll-story [style]{transform:none!important;opacity:1!important}.spring-ip-scroll-story{height:auto;padding:88px 0}.spring-ip-scroll-story__stage{position:relative;height:auto;min-height:0;display:grid;gap:42px;overflow:visible}.spring-ip-scroll-story__grid{height:auto}.spring-ip-scroll-story__shape{display:none}.spring-ip-scroll-story__character,.spring-ip-scroll-story__campaign,.spring-ip-scroll-story__campaign-copy{position:relative;right:auto;left:auto;bottom:auto;margin-inline:auto}.spring-ip-scroll-story__character{max-width:70%;max-height:52vh}.spring-ip-scroll-story__campaign{width:min(92vw,1400px)}.spring-ip-scroll-story__campaign-copy{width:min(1440px,calc(100vw - 96px))}}
