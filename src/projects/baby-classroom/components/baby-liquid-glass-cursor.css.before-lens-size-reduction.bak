.baby-liquid-glass-cursor{position:fixed;z-index:20;left:0;top:0;width:350px;height:212px;border-radius:32% 32% 34% 34% / 38% 38% 38% 38%;pointer-events:none;opacity:0;transition:opacity .18s ease;will-change:transform;overflow:hidden;box-shadow:5px 8px 18px rgba(64,111,143,.07)}.baby-liquid-glass-cursor[data-active="true"]{opacity:1}.baby-liquid-glass-cursor[data-debug]:after{content:attr(data-debug);position:absolute;left:0;top:calc(100% + 12px);width:320px;color:#16304b;background:#fff;padding:9px;font:11px/1.5 monospace;white-space:normal;z-index:30}@media(max-width:1023px),(hover:none),(pointer:coarse),(prefers-reduced-motion:reduce){.baby-liquid-glass-cursor{display:none!important}}
