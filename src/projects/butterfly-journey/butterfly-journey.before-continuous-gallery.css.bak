.butterfly-journey-page {
  --wine: #39130f;
  --wine-deep: #24100e;
  --wine-soft: #4a1b15;
  --cream: #f1e8d9;
  --cream-deep: #e8dac8;
  --gold: #d0a25b;
  --gold-muted: #b98955;
  --ink: #431711;
  position: fixed;
  z-index: 20;
  inset: 0;
  overflow: auto;
  background: var(--wine);
  color: var(--cream);
  font-family: var(--font-body-cn);
  scroll-behavior: smooth;
}

.butterfly-journey-page * { box-sizing: border-box; }
.butterfly-journey-page__back {
  position: fixed;
  z-index: 30;
  top: 24px;
  left: 24px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-height: 46px;
  padding: 0 14px;
  border: 1px solid rgba(208, 162, 91, .34);
  border-radius: 999px;
  background: rgba(57, 19, 15, .34);
  color: var(--cream);
  font: 600 15px/1 var(--font-body-cn);
  letter-spacing: .03em;
  cursor: pointer;
  backdrop-filter: blur(7px);
  transition: background .2s ease-out, color .2s ease-out;
}
.butterfly-journey-page__back > span { font-size: 20px; transition: transform .2s ease-out; }
.butterfly-journey-page__back:hover { background: rgba(57, 19, 15, .7); color: #fff8eb; }
.butterfly-journey-page__back:hover > span { transform: translateX(-3px); }
.butterfly-journey-page__back:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }

.butterfly-journey-page__hero {
  position: relative;
  isolation: isolate;
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  column-gap: 24px;
  width: min(1480px, calc(100vw - 96px));
  min-height: 118svh;
  margin-inline: auto;
  padding: clamp(136px, 16vh, 188px) 0 clamp(92px, 10vh, 144px);
  overflow: visible;
  background: radial-gradient(circle at 76% 32%, rgba(169, 69, 38, .11), transparent 35%), repeating-linear-gradient(0deg, rgba(255,255,255,.018) 0 1px, transparent 1px 9px), var(--wine);
}
.butterfly-journey-page__hero::before { content: ''; position: absolute; z-index: -1; inset: 0 calc((100vw - min(1480px, calc(100vw - 96px))) / -2); background: inherit; }
.butterfly-journey-page__hero-copy { z-index: 4; grid-column: 1 / span 8; align-self: start; max-width: 900px; }
.butterfly-journey-page__index,
.butterfly-journey-page__category { display: block; margin: 0; color: var(--gold); font-size: 12px; font-weight: 700; line-height: 1.3; letter-spacing: .15em; }
.butterfly-journey-page__category { margin-top: 20px; color: #d8bd8b; }
.butterfly-journey-page__hero h1 { margin: 26px 0 0; color: #e9d7b4; font-family: var(--font-display-cn); font-size: clamp(78px, 8.2vw, 150px); font-weight: 400; line-height: .9; letter-spacing: .035em; white-space: nowrap; }
.butterfly-journey-page__hero strong { display: block; margin-top: 34px; color: #dfc690; font-size: clamp(20px, 2vw, 30px); font-weight: 500; letter-spacing: .045em; }
.butterfly-journey-page__guide { display: flex; align-items: center; flex-wrap: wrap; gap: 11px 14px; margin-top: 28px; color: rgba(238,224,199,.68); font-size: 11px; font-weight: 700; letter-spacing: .15em; }
.butterfly-journey-page__guide i { display: block; width: clamp(120px, 15vw, 250px); height: 1px; background: rgba(217,177,111,.48); }
.butterfly-journey-page__hero-number { position: absolute; z-index: -1; top: 11vh; right: -2.6vw; color: var(--gold); font-size: clamp(180px, 20vw, 380px); font-weight: 300; line-height: .8; opacity: .09; pointer-events: none; }
.butterfly-journey-page__hero-visual { z-index: 3; grid-column: 7 / span 6; align-self: end; min-width: 0; margin: clamp(90px, 16vh, 180px) 0 -15vh; overflow: hidden; border: 1px solid rgba(208, 162, 91, .24); background: var(--wine-deep); box-shadow: 0 34px 80px rgba(16, 3, 2, .24); transition: transform .45s cubic-bezier(.22,1,.36,1); }
.butterfly-journey-page__hero-visual img { display: block; width: 100%; height: auto; object-fit: contain; transition: transform .45s cubic-bezier(.22,1,.36,1); }
.butterfly-journey-page__hero-visual:hover { transform: scale(.995); }
.butterfly-journey-page__hero-visual:hover img { transform: scale(1.015); }
.butterfly-journey-page__chapter-index { position: fixed; z-index: 15; top: 50%; right: clamp(20px, 2.4vw, 48px); display: grid; gap: 14px; transform: translateY(-50%); }
.butterfly-journey-page__chapter-index a { display: flex; align-items: center; justify-content: flex-end; gap: 10px; color: rgba(233,215,180,.32); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-decoration: none; transition: color .3s ease, opacity .3s ease; white-space: nowrap; }
.butterfly-journey-page__chapter-index a:hover { color: rgba(233,215,180,.7); }
.butterfly-journey-page__chapter-index i { width: 0; height: 1px; background: currentColor; transition: width .3s ease; }
.butterfly-journey-page__chapter-index .is-active { color: var(--gold); }
.butterfly-journey-page__chapter-index .is-active i { width: 38px; }

.butterfly-journey-page__gallery { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: clamp(112px, 13vw, 180px); padding: clamp(180px, 22vh, 260px) max(48px, calc((100vw - 1480px) / 2)) 180px; background: var(--cream); }
.butterfly-journey-page__gallery-item { min-width: 0; margin: 0; }
.butterfly-journey-page__artwork-reveal { overflow: hidden; background: var(--wine-deep); transition: transform .45s cubic-bezier(.22,1,.36,1); }
.butterfly-journey-page__artwork-reveal img { display: block; width: 100%; height: 100%; object-fit: contain; transition: transform .45s cubic-bezier(.22,1,.36,1); }
.butterfly-journey-page__gallery-item:hover .butterfly-journey-page__artwork-reveal { transform: scale(.995); }
.butterfly-journey-page__gallery-item:hover .butterfly-journey-page__artwork-reveal img { transform: scale(1.015); }
.butterfly-journey-page__gallery-item figcaption { display: grid; gap: 14px; align-content: start; }
.butterfly-journey-page__gallery-item figcaption span,
.butterfly-journey-page__gallery-item figcaption small { color: var(--gold-muted); font-size: 11px; font-weight: 700; letter-spacing: .15em; }
.butterfly-journey-page__gallery-item figcaption strong { color: var(--ink); font-family: var(--font-display-cn); font-size: clamp(52px, 6vw, 100px); font-weight: 400; line-height: .95; letter-spacing: .035em; white-space: nowrap; }
.butterfly-journey-page__gallery-item figcaption p { max-width: 560px; margin: 8px 0 0; color: rgba(67,23,17,.76); font-size: 17px; line-height: 1.82; }
.butterfly-journey-page__gallery-item figcaption small { margin-top: 14px; color: rgba(67,23,17,.55); font-size: 10px; }

/* Mode B — editorial: four columns of copy and eight columns of artwork. */
.butterfly-journey-page__gallery-item.is-item-2 { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; align-items: center; padding-block: clamp(120px, 14vw, 180px); background: var(--cream); }
.butterfly-journey-page__gallery-item.is-item-2 figcaption { grid-column: 1 / span 4; grid-row: 1; padding-right: 18px; }
.butterfly-journey-page__gallery-item.is-item-2 .butterfly-journey-page__artwork-reveal { grid-column: 5 / span 8; grid-row: 1; }
/* Mode A — full feature visual, with a restrained editorial caption. */
.butterfly-journey-page__gallery-item.is-item-3 { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; padding: clamp(110px, 13vw, 170px) 0; background: var(--wine); }
.butterfly-journey-page__gallery-item.is-item-3 .butterfly-journey-page__artwork-reveal { grid-column: 1 / -1; }
.butterfly-journey-page__gallery-item.is-item-3 figcaption { grid-column: 1 / span 5; margin-top: 24px; }
.butterfly-journey-page__gallery-item.is-item-3 figcaption strong { color: var(--cream); }
.butterfly-journey-page__gallery-item.is-item-3 figcaption p { color: rgba(238,224,199,.68); }
.butterfly-journey-page__gallery-item.is-item-3 figcaption small { color: rgba(238,224,199,.55); }
/* The page's second climax: full-height visual instead of another ordinary image row. */
.butterfly-journey-page__gallery-item.is-item-4 { grid-column: 1 / -1; display: grid; place-items: center; min-height: 100svh; padding: 80px 0; background: var(--wine-deep); }
.butterfly-journey-page__gallery-item.is-item-4 .butterfly-journey-page__artwork-reveal { width: min(100%, 1280px); max-height: 78svh; }
.butterfly-journey-page__gallery-item.is-item-4 .butterfly-journey-page__artwork-reveal img { max-height: 78svh; }
.butterfly-journey-page__gallery-item.is-item-4 figcaption { width: min(100%, 1280px); margin-top: 18px; }
.butterfly-journey-page__gallery-item.is-item-4 figcaption strong { color: var(--cream); font-size: clamp(38px, 4vw, 72px); }
.butterfly-journey-page__gallery-item.is-item-4 figcaption p { color: rgba(238,224,199,.68); }
.butterfly-journey-page__gallery-item.is-item-4 figcaption small { color: rgba(238,224,199,.55); }
/* Mode C — an equal, two-work comparison. */
.butterfly-journey-page__gallery-item.is-item-5,
.butterfly-journey-page__gallery-item.is-item-6 { grid-column: span 6; align-self: start; }
.butterfly-journey-page__gallery-item.is-item-5 .butterfly-journey-page__artwork-reveal,
.butterfly-journey-page__gallery-item.is-item-6 .butterfly-journey-page__artwork-reveal { aspect-ratio: 4 / 3; }
.butterfly-journey-page__gallery-item.is-item-5 figcaption,
.butterfly-journey-page__gallery-item.is-item-6 figcaption { margin-top: 18px; }
.butterfly-journey-page__gallery-item.is-item-5 figcaption strong,
.butterfly-journey-page__gallery-item.is-item-6 figcaption strong { font-size: clamp(38px, 4vw, 68px); }

@media (max-width: 899px) {
  .butterfly-journey-page__back { top: max(14px, env(safe-area-inset-top)); left: 16px; min-height: 44px; }
  .butterfly-journey-page__hero { display: block; width: 100%; min-height: auto; padding: 110px 20px 74px; overflow: hidden; }
  .butterfly-journey-page__hero::before { inset: 0; }
  .butterfly-journey-page__hero-copy { max-width: none; }
  .butterfly-journey-page__hero h1 { font-size: clamp(54px, 17vw, 82px); line-height: .94; white-space: normal; }
  .butterfly-journey-page__hero strong { margin-top: 28px; font-size: 20px; }
  .butterfly-journey-page__guide { margin-top: 24px; }
  .butterfly-journey-page__hero-number,
  .butterfly-journey-page__chapter-index { display: none; }
  .butterfly-journey-page__hero-visual { margin: 66px 0 0; }
  .butterfly-journey-page__gallery { display: block; padding: 0 20px 96px; background: var(--cream); }
  .butterfly-journey-page__gallery-item,
  .butterfly-journey-page__gallery-item.is-item-2,
  .butterfly-journey-page__gallery-item.is-item-3,
  .butterfly-journey-page__gallery-item.is-item-4,
  .butterfly-journey-page__gallery-item.is-item-5,
  .butterfly-journey-page__gallery-item.is-item-6 { display: block; min-height: auto; margin: 0 -20px; padding: 88px 20px; background: var(--cream); }
  .butterfly-journey-page__gallery-item.is-item-3,
  .butterfly-journey-page__gallery-item.is-item-4 { background: var(--wine); }
  .butterfly-journey-page__gallery-item.is-item-4 .butterfly-journey-page__artwork-reveal,
  .butterfly-journey-page__gallery-item.is-item-4 figcaption { width: 100%; max-height: none; }
  .butterfly-journey-page__gallery-item.is-item-4 .butterfly-journey-page__artwork-reveal img { max-height: none; }
  .butterfly-journey-page__gallery-item figcaption { margin-top: 20px; }
  .butterfly-journey-page__gallery-item figcaption strong { font-size: clamp(42px, 13vw, 64px); white-space: normal; }
  .butterfly-journey-page__gallery-item figcaption p { font-size: 16px; line-height: 1.75; }
  .butterfly-journey-page__gallery-item.is-item-5 .butterfly-journey-page__artwork-reveal,
  .butterfly-journey-page__gallery-item.is-item-6 .butterfly-journey-page__artwork-reveal { aspect-ratio: auto; }
}

@media (prefers-reduced-motion: reduce) {
  .butterfly-journey-page { scroll-behavior: auto; }
  .butterfly-journey-page *, .butterfly-journey-page *::before, .butterfly-journey-page *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
}
