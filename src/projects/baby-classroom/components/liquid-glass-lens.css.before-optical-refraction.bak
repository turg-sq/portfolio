.liquid-glass-lens{display:none}

@media (min-width:1024px) and (hover:hover) and (pointer:fine){
  .liquid-glass-lens{position:absolute;z-index:8;inset:0;display:block;overflow:hidden;pointer-events:none;opacity:0;transition:opacity .16s ease-out}
  .liquid-glass-lens[data-active="true"]{opacity:1}
  .liquid-glass-lens[data-mode="blank"]{opacity:.5}
  .liquid-glass-lens[data-mode="visual"]{opacity:.76}
  .liquid-glass-lens[data-mode="title"]{opacity:.88}
  .liquid-glass-lens__defs{position:absolute;width:0;height:0;overflow:hidden}
  .liquid-glass-lens__body{position:absolute;left:0;top:0;width:clamp(350px,20.3vw,390px);height:clamp(210px,12vw,230px);overflow:hidden;border-radius:52% 48% 51% 49% / 47% 53% 46% 54%;background:rgba(255,255,255,.014);box-shadow:7px 11px 25px rgba(33,73,99,.12),-2px -2px 15px rgba(255,255,255,.14),inset 12px 10px 18px rgba(255,255,255,.11),inset -12px -12px 18px rgba(30,59,82,.065);will-change:transform}
  .liquid-glass-lens__body:before{content:'';position:absolute;z-index:5;inset:0;border-radius:inherit;background:radial-gradient(ellipse 98% 94% at 34% 25%,transparent 55%,rgba(255,255,255,.21) 78%,rgba(255,255,255,.035) 87%,transparent 100%),radial-gradient(ellipse 106% 100% at 75% 81%,transparent 59%,rgba(27,54,76,.085) 86%,transparent 100%),linear-gradient(135deg,rgba(255,255,255,.075),transparent 29%,transparent 72%,rgba(29,63,88,.055));pointer-events:none}
  .liquid-glass-lens__body:after{content:'';position:absolute;z-index:6;right:7%;bottom:3%;left:8%;height:18%;border-radius:50%;background:radial-gradient(ellipse at center,rgba(222,248,255,.085),rgba(142,213,243,.035) 44%,transparent 76%);pointer-events:none}
  .liquid-glass-lens__scene{position:absolute;inset:0;width:max-content;height:max-content;will-change:transform;pointer-events:none}
  .liquid-glass-lens__scene>.hero{position:relative;min-height:100%;overflow:hidden;pointer-events:none}
  .liquid-glass-lens__scene--edge{mask-image:radial-gradient(ellipse at center,transparent 0 35%,rgba(0,0,0,.1) 52%,rgba(0,0,0,.56) 68%,#000 82%,rgba(0,0,0,.9) 94%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse at center,transparent 0 35%,rgba(0,0,0,.1) 52%,rgba(0,0,0,.56) 68%,#000 82%,rgba(0,0,0,.9) 94%,transparent 100%);opacity:.74}
  .liquid-glass-lens__scene--cyan{mask-image:radial-gradient(ellipse at 30% 45%,transparent 0 68%,rgba(0,0,0,.9) 85%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse at 30% 45%,transparent 0 68%,rgba(0,0,0,.9) 85%,transparent 100%);opacity:.11;mix-blend-mode:screen;margin-left:2px}
  .liquid-glass-lens__scene--warm{mask-image:radial-gradient(ellipse at 72% 62%,transparent 0 68%,rgba(0,0,0,.88) 85%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse at 72% 62%,transparent 0 68%,rgba(0,0,0,.88) 85%,transparent 100%);opacity:.075;mix-blend-mode:multiply;margin-left:-2px}
  .liquid-glass-lens[data-mode="title"] .liquid-glass-lens__scene--cyan{margin-left:2.5px;opacity:.14}
  .liquid-glass-lens[data-mode="title"] .liquid-glass-lens__scene--warm{margin-left:-2.5px;opacity:.1}
  .liquid-glass-lens__specular{position:absolute;z-index:7;display:block;border-radius:50%;pointer-events:none}
  .liquid-glass-lens__specular--primary{top:7%;left:10%;width:46%;height:25%;background:radial-gradient(ellipse at center,rgba(255,255,255,.17),rgba(255,255,255,.075) 39%,transparent 72%);transform:rotate(-13deg)}
  .liquid-glass-lens__specular--secondary{right:11%;bottom:15%;width:26%;height:16%;background:radial-gradient(ellipse at center,rgba(217,247,255,.075),transparent 70%);transform:rotate(18deg)}
  .liquid-glass-lens__caustic{position:absolute;z-index:7;right:14%;bottom:5%;width:36%;height:8%;border-radius:50%;background:radial-gradient(ellipse at center,rgba(221,248,255,.08),transparent 74%);transform:rotate(-8deg);pointer-events:none}
}

@media (max-width:1023px), (hover:none), (pointer:coarse), (prefers-reduced-motion:reduce){.liquid-glass-lens{display:none!important}}
