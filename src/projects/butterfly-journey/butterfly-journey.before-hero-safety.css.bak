.butterfly-journey-page{--butterfly-bg:#140605;--butterfly-bg-soft:#1b0b09;--butterfly-gold:#c89b4c;--butterfly-cream:#f1e2c6;--butterfly-muted:#9f896b;position:fixed;z-index:20;inset:0;overflow:auto;background:var(--butterfly-bg);color:var(--butterfly-cream);font-family:var(--font-body-cn)}
.butterfly-journey-page *{box-sizing:border-box}.butterfly-journey-page__back{position:fixed;z-index:20;top:24px;left:24px;display:inline-flex;align-items:center;gap:9px;min-height:46px;padding:0;border:0;background:transparent;color:var(--butterfly-cream);font:600 15px/1 var(--font-body-cn);letter-spacing:.03em;cursor:pointer;transition:letter-spacing .2s ease-out,color .2s ease-out}.butterfly-journey-page__back>span{font-size:22px;line-height:1;transition:transform .2s ease-out}.butterfly-journey-page__back:hover{color:#fff6e5;letter-spacing:.07em}.butterfly-journey-page__back:hover>span{transform:translateX(-6px)}.butterfly-journey-page__back:focus-visible{outline:2px solid var(--butterfly-gold);outline-offset:6px}

.butterfly-journey-page__hero{position:relative;min-height:100svh;padding:clamp(112px,14vh,166px) clamp(24px,4vw,72px) 0;overflow:visible;background:radial-gradient(circle at 72% 30%,rgba(139,54,31,.13),transparent 42%),repeating-linear-gradient(0deg,rgba(255,255,255,.015) 0 1px,transparent 1px 8px),var(--butterfly-bg)}.butterfly-journey-page__hero-copy{position:relative;z-index:4;width:min(760px,56vw)}.butterfly-journey-page__index,.butterfly-journey-page__category{display:block;margin:0;color:var(--butterfly-gold);font-size:12px;font-weight:700;line-height:1.3;letter-spacing:.15em}.butterfly-journey-page__category{margin-top:22px;color:#d6ba84}.butterfly-journey-page__hero h1{max-width:760px;margin:24px 0 0;color:var(--butterfly-cream);font-family:var(--font-display-cn);font-size:clamp(76px,9vw,154px);font-weight:400;line-height:.9;letter-spacing:.04em}.butterfly-journey-page__hero strong{display:block;margin-top:28px;color:#d6ba84;font-size:clamp(20px,2vw,30px);font-weight:500;letter-spacing:.04em}.butterfly-journey-page__guide{display:flex;align-items:center;gap:13px;margin-top:28px;color:rgba(241,226,198,.62);font-size:11px;font-weight:700;letter-spacing:.16em}.butterfly-journey-page__guide i{display:block;width:clamp(120px,15vw,260px);height:1px;background:rgba(200,155,76,.7)}.butterfly-journey-page__hero-number{position:absolute;z-index:0;right:4vw;top:12vh;color:rgba(200,155,76,.055);font-size:clamp(180px,24vw,420px);font-weight:300;line-height:.8;pointer-events:none}.butterfly-journey-page__hero-visual{position:absolute;z-index:2;left:clamp(360px,31vw,590px);right:clamp(24px,4vw,72px);top:47%;bottom:-11%;display:flex;align-items:flex-start;justify-content:flex-end;margin:0;overflow:hidden;border:1px solid rgba(200,155,76,.22);border-radius:2px;box-shadow:0 40px 100px rgba(0,0,0,.22);background:#160908;transition:transform .5s cubic-bezier(.22,1,.36,1)}.butterfly-journey-page__hero-visual img{display:block;width:100%;height:100%;object-fit:contain;transition:transform .5s cubic-bezier(.22,1,.36,1)}.butterfly-journey-page__hero-visual:hover{transform:scale(.992)}.butterfly-journey-page__hero-visual:hover img{transform:scale(1.012)}.butterfly-journey-page__chapter-index{position:absolute;z-index:5;right:clamp(20px,2.5vw,46px);top:50%;display:grid;gap:12px;transform:translateY(-50%);font-size:10px;letter-spacing:.12em}.butterfly-journey-page__chapter-index span{display:flex;align-items:center;justify-content:flex-end;gap:10px;color:rgba(241,226,198,.35);white-space:nowrap}.butterfly-journey-page__chapter-index .is-active{color:var(--butterfly-gold)}.butterfly-journey-page__chapter-index i{display:block;width:40px;height:1px;background:currentColor}

.butterfly-journey-page__gallery{position:relative;z-index:1;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:clamp(64px,9vw,144px) 24px;padding:clamp(150px,18vh,220px) clamp(24px,4vw,72px) 120px;background:var(--butterfly-bg-soft)}.butterfly-journey-page__gallery:before{content:'';position:absolute;left:0;right:0;top:0;height:150px;background:linear-gradient(to bottom,var(--butterfly-bg),transparent);pointer-events:none}.butterfly-journey-page__gallery-item{min-width:0;margin:0}.butterfly-journey-page__gallery-item img{display:block;width:100%;height:auto;border:1px solid rgba(200,155,76,.17);border-radius:2px;object-fit:contain}.butterfly-journey-page__gallery-item figcaption{display:grid;gap:8px;max-width:620px;margin-top:18px}.butterfly-journey-page__gallery-item figcaption span{color:var(--butterfly-gold);font-size:11px;font-weight:700;letter-spacing:.15em}.butterfly-journey-page__gallery-item figcaption strong{color:var(--butterfly-cream);font-family:var(--font-display-cn);font-size:clamp(24px,2.5vw,42px);font-weight:400;line-height:1.15;letter-spacing:.03em}.butterfly-journey-page__gallery-item.is-item-2{grid-column:1 / span 8}.butterfly-journey-page__gallery-item.is-item-3{grid-column:5 / span 8}.butterfly-journey-page__gallery-item.is-item-4{grid-column:1 / -1}.butterfly-journey-page__gallery-item.is-item-5{grid-column:3 / span 8}.butterfly-journey-page__gallery-item.is-item-6{grid-column:1 / span 6}

@media(max-width:899px){.butterfly-journey-page__back{top:max(14px,env(safe-area-inset-top));left:16px;min-height:44px}.butterfly-journey-page__hero{min-height:auto;padding:98px 16px 0;overflow:hidden}.butterfly-journey-page__hero-copy{width:100%}.butterfly-journey-page__hero h1{font-size:clamp(58px,15vw,96px);line-height:.95}.butterfly-journey-page__hero strong{margin-top:24px;font-size:20px}.butterfly-journey-page__guide{flex-wrap:wrap;gap:10px 12px}.butterfly-journey-page__guide i{width:120px}.butterfly-journey-page__hero-number{right:12px;top:112px;font-size:160px}.butterfly-journey-page__hero-visual{position:relative;inset:auto;display:block;width:calc(100vw - 32px);height:auto;margin:52px 0 -22px}.butterfly-journey-page__hero-visual img{width:100%;height:auto;object-fit:contain}.butterfly-journey-page__chapter-index{display:none}.butterfly-journey-page__gallery{grid-template-columns:1fr;gap:72px;padding:92px 16px 64px}.butterfly-journey-page__gallery-item.is-item-2,.butterfly-journey-page__gallery-item.is-item-3,.butterfly-journey-page__gallery-item.is-item-4,.butterfly-journey-page__gallery-item.is-item-5,.butterfly-journey-page__gallery-item.is-item-6{grid-column:auto}.butterfly-journey-page__gallery-item figcaption{margin-top:14px}.butterfly-journey-page__gallery-item figcaption strong{font-size:28px}}
