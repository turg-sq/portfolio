.baby-liquid-glass-cursor{position:fixed;z-index:20;left:0;top:0;width:360px;height:220px;border-radius:46% 54% 49% 51% / 52% 47% 53% 48%;pointer-events:none;opacity:0;transition:opacity .18s ease;will-change:transform;overflow:hidden}.baby-liquid-glass-cursor[data-active="true"]{opacity:1}.baby-liquid-glass-cursor[data-debug]:after{content:attr(data-debug);position:absolute;left:0;top:calc(100% + 12px);width:320px;color:#16304b;background:#fff;padding:9px;font:11px/1.5 monospace;white-space:normal;z-index:30}@media(max-width:1023px),(hover:none),(pointer:coarse),(prefers-reduced-motion:reduce){.baby-liquid-glass-cursor{display:none!important}}
