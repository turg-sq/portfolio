.red-sun-page{--red-sun-cream:#f3ead8;--red-sun-paper:#fff9ed;--red-sun-red:#b43b2f;--red-sun-coral:#cf5b4e;--red-sun-ink:#25201c;--red-sun-gold:#bd9148;position:fixed;z-index:20;inset:0;overflow:auto;background:var(--red-sun-paper);color:var(--red-sun-ink);font-family:var(--font-body-cn)}.red-sun-page *{box-sizing:border-box}.red-sun-page__back{position:fixed;z-index:200;top:24px;left:24px;display:inline-flex;align-items:center;gap:9px;min-height:46px;padding:0 18px;border:0;border-radius:999px;background:rgba(37,32,28,.9);color:#fff;font:600 15px/1 var(--font-body-cn);cursor:pointer;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transition:background .18s ease-out,transform .18s ease-out}.red-sun-page__back>span{transition:transform .18s ease-out}.red-sun-page__back:hover{background:#b43b2f}.red-sun-page__back:hover>span{transform:translateX(-2px)}.red-sun-page__back:active{transform:scale(.97)}.red-sun-page__back:focus-visible{outline:3px solid rgba(189,145,72,.7);outline-offset:4px}.red-sun-hero,.red-sun-section{width:min(1280px,calc(100% - 96px));margin:0 auto}.red-sun-hero{position:relative;min-height:100svh;display:grid;grid-template-columns:minmax(0,.78fr) minmax(480px,1.22fr);align-items:center;gap:clamp(34px,6vw,96px);padding:124px 0 78px;overflow:hidden}.red-sun-hero:before{content:'';position:absolute;inset:0;z-index:-1;background:repeating-radial-gradient(ellipse at 88% 56%,transparent 0 18px,rgba(180,59,47,.045) 19px 20px,transparent 21px 39px),linear-gradient(120deg,#f3ead8,#fff9ed 54%,#f6e5c9)}.red-sun-hero__eyebrow,.red-sun-heading>span,.red-sun-heading p{margin:0;color:var(--red-sun-red);font:700 12px/1.25 var(--font-body-cn);letter-spacing:.14em}.red-sun-hero h1{margin:26px 0 0;font-family:var(--font-display-cn);font-size:clamp(58px,7.2vw,112px);font-weight:400;line-height:1.05;letter-spacing:.035em}.red-sun-hero__description{max-width:500px;margin:30px 0 0;font-size:18px;line-height:1.8}.red-sun-hero__tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:26px}.red-sun-hero__tags span{padding:8px 11px;border:1px solid rgba(180,59,47,.25);border-radius:999px;color:#733229;font-size:13px}.red-sun-hero__facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 28px;max-width:530px;margin:46px 0 0;padding-top:18px;border-top:1px solid rgba(37,32,28,.16)}.red-sun-hero__facts div{display:grid;gap:7px}.red-sun-hero__facts dt{color:#8c6756;font-size:10px;font-weight:700;letter-spacing:.14em}.red-sun-hero__facts dd{margin:0;font-size:14px;line-height:1.45}.red-sun-hero__stage{position:relative;min-height:620px;align-self:end}.red-sun-hero__stage:after{content:'';position:absolute;right:5%;bottom:12%;width:75%;height:13%;border-radius:50%;background:rgba(99,45,32,.16);filter:blur(22px)}.red-sun-hero__bag,.red-sun-hero__box{position:absolute;display:block;max-width:none;height:auto;object-fit:contain;filter:drop-shadow(0 28px 24px rgba(69,39,28,.2))}.red-sun-hero__bag{z-index:1;top:3%;right:-7%;width:clamp(300px,31vw,560px)}.red-sun-hero__box{z-index:2;right:-9%;bottom:-7%;width:clamp(420px,42vw,760px)}.red-sun-section{padding-block:112px}.red-sun-heading{display:grid;grid-template-columns:84px minmax(0,1fr);gap:28px;margin-bottom:54px}.red-sun-heading h2{margin:12px 0 0;font-family:var(--font-display-cn);font-size:clamp(44px,5vw,76px);font-weight:400;line-height:1.06;letter-spacing:.04em}.red-sun-heading.is-inverse>span,.red-sun-heading.is-inverse p{color:#e5c68f}.red-sun-heading.is-inverse h2{color:#fff5e8}.red-sun-image{margin:0;overflow:hidden;border-radius:15px}.red-sun-image img{display:block;width:100%;height:auto;object-fit:contain;border-radius:15px}.red-sun-overview{background:var(--red-sun-cream)}.red-sun-overview__grid{display:grid;grid-template-columns:minmax(260px,.4fr) minmax(0,.6fr);align-items:center;gap:clamp(48px,8vw,120px)}.red-sun-overview__grid>p{max-width:440px;margin:0;font-size:18px;line-height:1.85}.red-sun-role{max-width:none;width:100%;padding-inline:max(48px,calc((100vw - 1280px)/2));background:#fffaf0}.red-sun-role .red-sun-heading,.red-sun-role__grid{max-width:1280px;margin-left:auto;margin-right:auto}.red-sun-role__grid{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:0;border-top:1px solid rgba(37,32,28,.18)}.red-sun-role__grid article{min-height:225px;padding:26px 30px 20px;border-right:1px solid rgba(37,32,28,.14)}.red-sun-role__grid article:first-child{padding-left:0}.red-sun-role__grid article:last-child{border-right:0}.red-sun-role__grid span{display:block;color:var(--red-sun-red);font-size:14px;font-weight:700;letter-spacing:.06em}.red-sun-role__grid p{max-width:315px;margin:30px 0 0;line-height:1.8}.red-sun-packaging{max-width:none;width:100%;padding-inline:max(48px,calc((100vw - 1280px)/2));background:var(--red-sun-red);color:#fff5e8;overflow:hidden}.red-sun-packaging:before{content:'';position:absolute}.red-sun-packaging .red-sun-heading,.red-sun-packaging__layout{max-width:1280px;margin-left:auto;margin-right:auto}.red-sun-packaging__layout{display:grid;grid-template-columns:minmax(250px,.38fr) minmax(0,.62fr);align-items:center;gap:clamp(42px,7vw,110px)}.red-sun-packaging__copy{display:grid;gap:32px}.red-sun-packaging__copy article{padding-left:18px;border-left:1px solid rgba(255,245,232,.44)}.red-sun-packaging__copy h3{margin:0;font-family:var(--font-display-cn);font-size:25px;font-weight:400;letter-spacing:.03em}.red-sun-packaging__copy p{max-width:300px;margin:10px 0 0;color:#f9ded4;line-height:1.7}.red-sun-packaging__stage{position:relative;min-height:560px;background:radial-gradient(circle at 78% 30%,rgba(240,204,142,.17),transparent 28%),repeating-radial-gradient(ellipse at 60% 55%,transparent 0 20px,rgba(255,245,232,.06) 21px 22px,transparent 23px 42px)}.red-sun-packaging__stage img{position:absolute;display:block;height:auto;object-fit:contain;filter:drop-shadow(0 30px 24px rgba(55,12,10,.28))}.red-sun-packaging__bag{z-index:1;top:-4%;right:-2%;width:min(80%,560px)}.red-sun-packaging__box{z-index:2;bottom:-11%;left:-6%;width:min(95%,700px)}.red-sun-product-display{max-width:none;width:100%;padding-inline:max(48px,calc((100vw - 1280px)/2));background:#f4efe6}.red-sun-product-display .red-sun-heading,.red-sun-product-display__image{max-width:1280px;margin-left:auto;margin-right:auto}.red-sun-product-display__image{margin-bottom:0;overflow:hidden;border-radius:15px}.red-sun-product-display__image img{display:block;width:100%;height:auto;object-fit:contain}.red-sun-festival{max-width:none;width:100%;padding-inline:max(48px,calc((100vw - 1280px)/2));background:#c9c4af}.red-sun-festival .red-sun-heading,.red-sun-festival__intro,.red-sun-festival__gallery{max-width:1280px;margin-left:auto;margin-right:auto}.red-sun-festival__intro{display:grid;grid-template-columns:1fr minmax(280px,.52fr);gap:50px;margin-bottom:64px}.red-sun-festival__intro h3{margin:0;font-family:var(--font-display-cn);font-size:clamp(32px,4vw,56px);font-weight:400;letter-spacing:.03em}.red-sun-festival__intro p{max-width:440px;margin:0;line-height:1.8}.red-sun-festival__gallery{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);align-items:center;gap:clamp(36px,7vw,108px)}.red-sun-festival__gallery .is-green{width:92%;justify-self:start;transform:translateY(-80px)}.red-sun-festival__gallery .is-orange{width:100%;justify-self:end;transform:translateY(80px)}.red-sun-brand-story{background:var(--red-sun-paper)}.red-sun-brand-story__layout{display:grid;grid-template-columns:minmax(280px,.35fr) minmax(0,.65fr);gap:64px}.red-sun-brand-story aside{position:sticky;top:110px;height:fit-content}.red-sun-brand-story .red-sun-heading{grid-template-columns:1fr;gap:0}.red-sun-brand-story ul{display:flex;flex-wrap:wrap;gap:9px;margin:34px 0 0;padding:0;list-style:none}.red-sun-brand-story li{padding:8px 11px;border:1px solid rgba(180,59,47,.26);border-radius:999px;color:#7b372e;font-size:13px}.red-sun-identity{max-width:none;width:100%;padding-inline:max(48px,calc((100vw - 1280px)/2));background:#f2e7d6}.red-sun-identity .red-sun-heading,.red-sun-identity__logo,.red-sun-identity__story{max-width:1280px;margin-left:auto;margin-right:auto}.red-sun-identity__logo{margin-bottom:72px}.red-sun-identity__story{display:grid;grid-template-columns:minmax(240px,.25fr) minmax(0,.75fr);align-items:center;gap:clamp(44px,7vw,112px)}.red-sun-identity__story>p{max-width:315px;margin:0;font-size:18px;line-height:1.85}.red-sun-application{background:#e8e5dd}.red-sun-application__gallery{display:grid;gap:48px}.red-sun-application__gallery .is-primary{width:100%}.red-sun-application__gallery .is-secondary{width:72%;justify-self:end}.red-sun-summary{padding-bottom:124px;background:var(--red-sun-paper)}.red-sun-summary>p{max-width:680px;margin:0 0 0 112px;font-size:18px;line-height:1.85}.red-sun-next{display:grid;gap:11px;width:100%;padding:clamp(58px,8vw,124px) max(48px,calc((100vw - 1280px)/2));border:0;background:#25201c;color:#fff9ed;text-align:left;cursor:pointer}.red-sun-next span{color:#d6b77c;font-size:12px;font-weight:700;letter-spacing:.14em}.red-sun-next strong{font-family:var(--font-display-cn);font-size:clamp(36px,5vw,76px);font-weight:400;line-height:1.06;letter-spacing:.035em}.red-sun-next:focus-visible{outline:3px solid var(--red-sun-gold);outline-offset:-7px}@media(max-width:767px){.red-sun-page__back{top:max(14px,env(safe-area-inset-top));left:14px;min-height:44px;padding:0 16px}.red-sun-hero,.red-sun-section{width:calc(100% - 32px)}.red-sun-hero{grid-template-columns:1fr;gap:26px;min-height:auto;padding:104px 0 42px}.red-sun-hero__description{font-size:16px}.red-sun-hero__stage{min-height:380px;order:2}.red-sun-hero__bag{top:0;right:-10%;width:min(112%,410px)}.red-sun-hero__box{right:-12%;bottom:-9%;width:min(128%,520px)}.red-sun-hero__facts{gap:16px;margin-top:32px}.red-sun-section{padding-block:68px}.red-sun-heading{grid-template-columns:1fr;gap:13px;margin-bottom:36px}.red-sun-heading h2{font-size:46px}.red-sun-overview__grid,.red-sun-packaging__layout,.red-sun-festival__intro,.red-sun-festival__gallery,.red-sun-brand-story__layout,.red-sun-identity__story{grid-template-columns:1fr;gap:32px}.red-sun-overview__grid>p,.red-sun-identity__story>p{font-size:16px}.red-sun-role,.red-sun-packaging,.red-sun-product-display,.red-sun-festival,.red-sun-identity{width:100%;padding-inline:16px}.red-sun-role__grid{grid-template-columns:1fr}.red-sun-role__grid article,.red-sun-role__grid article:first-child{min-height:0;padding:22px 0;border-right:0;border-bottom:1px solid rgba(37,32,28,.14)}.red-sun-role__grid article:last-child{border-bottom:0}.red-sun-role__grid p{margin-top:13px}.red-sun-packaging__stage{min-height:385px}.red-sun-packaging__bag{top:-3%;right:-6%;width:98%}.red-sun-packaging__box{left:-8%;bottom:-12%;width:112%}.red-sun-festival__intro{margin-bottom:34px}.red-sun-festival__intro p{font-size:16px}.red-sun-festival__gallery{gap:30px}.red-sun-festival__gallery .is-green,.red-sun-festival__gallery .is-orange{width:100%;transform:none}.red-sun-brand-story aside{position:static}.red-sun-brand-story__layout{gap:38px}.red-sun-identity__logo{margin-bottom:34px}.red-sun-application__gallery{gap:22px}.red-sun-application__gallery .is-secondary{width:100%;justify-self:stretch}.red-sun-summary>p{margin-left:0;font-size:16px}.red-sun-next{padding:68px 16px}}
