import { motion } from 'framer-motion'
import { Reveal, TitleReveal } from '../components/Reveal'
const items = [['项目类型', '儿童教育 App'], ['设计方向', 'UI / UX Design'], ['核心理念', '让学习更加有趣']]
export default function Overview() { return <section id="overview" className="overview section"><div className="content overview-grid"><div className="overview-number">01</div><div className="overview-copy"><Reveal><p className="eyebrow">PROJECT OVERVIEW</p></Reveal><TitleReveal><h2>用好奇心，打开<br />每一次<span>学习</span></h2></TitleReveal><Reveal delay={.1}><p className="body-copy">围绕儿童的注意力、认知特点与陪伴需求，构建轻松、直觉且充满正反馈的启蒙学习体验。</p></Reveal><dl>{items.map(([term, text], i) => <Reveal delay={i * .08} key={term}><div><dt>{term}</dt><dd>{text}</dd></div></Reveal>)}</dl></div><motion.div className="overview-visual glass" initial={{ opacity: 0, rotate: 3 }} whileInView={{ opacity: 1, rotate: 0 }} viewport={{ once: true, amount: .4 }} whileHover={{ y: -7 }}><img src="/assets/projects/baby-classroom/images/home.png" alt="宝宝小课堂首页设计展示" /></motion.div></div></section> }
