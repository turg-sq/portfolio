.contact-page{min-height:100svh;background:#060606;color:#fff;padding:28px clamp(24px,7vw,112px);font-family:var(--font-body-cn)}.contact-page__back{padding:0;border:0;background:none;color:#fff;font:600 14px/1 var(--font-body-cn);cursor:pointer;opacity:.76}.contact-page__layout{display:grid;grid-template-columns:minmax(0,55%) minmax(0,45%);min-height:calc(100svh - 76px);align-items:center}.contact-page__title-block{width:min(100%,760px);margin-top:-5vh;padding:clamp(34px,4.6vw,74px) clamp(28px,5vw,76px);background:#273c59}.contact-page h1{margin:0;font-size:clamp(64px,6vw,108px);font-weight:700;line-height:1}.contact-page__details{margin-top:clamp(64px,10vh,130px);padding-left:clamp(6px,2vw,30px)}.contact-page__details h2{margin:0 0 36px;font-size:clamp(28px,2.25vw,36px);font-weight:500}.contact-page__details p{margin:10px 0;font-size:clamp(16px,1.4vw,23px);line-height:1.6}.contact-page__right{position:relative;display:grid;place-items:center}.contact-page__right img{display:block;width:min(66%,520px);height:min(64svh,680px);object-fit:cover;object-position:center top}.contact-page__lines{position:absolute;inset:10% 0 10% auto;display:flex;flex-direction:column;justify-content:space-between}.contact-page__lines i{display:block;width:3px;height:84px;background:#fff}@media(max-width:767px){.contact-page{padding:22px 20px 48px}.contact-page__layout{grid-template-columns:1fr;gap:44px;padding-top:42px}.contact-page__title-block{width:100%;margin:0;padding:34px 24px}.contact-page h1{font-size:clamp(48px,15vw,72px)}.contact-page__right{order:1}.contact-page__left{display:contents}.contact-page__title-block{order:0}.contact-page__details{order:2;margin:0;padding:0}.contact-page__right img{width:100%;max-width:420px;height:auto;max-height:64svh}.contact-page__lines{display:none}}
