import { motion } from 'framer-motion'
import MagneticButton from '../components/MagneticButton'
import { Reveal, TitleReveal } from '../components/Reveal'
export default function FinalDemo() { return <section id="demo" className="final-demo section"><div className="content final-inner"><div><Reveal><p className="eyebrow">06 / FINAL DEMO</p></Reveal><TitleReveal><h2>陪伴每个<br /><span>好奇的开始</span></h2></TitleReveal><Reveal delay={.12}><p className="body-copy">宝宝小课堂以温暖 IP、探索地图和即时反馈，将启蒙学习变成孩子乐于开启的日常。</p><MagneticButton href="/assets/projects/baby-classroom/images/motion-login.mp4" target="_blank">打开 Demo <span>↗</span></MagneticButton></Reveal></div><motion.div className="final-phone" initial={{ opacity: 0, y: 36 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ duration: .8 }} whileHover={{ y: -10 }}><img src="/assets/projects/baby-classroom/images/profile.png" alt="宝宝小课堂最终 Demo 展示" /></motion.div></div><footer>宝宝小课堂 · UI / UX Case Study <span>2026</span></footer></section> }
