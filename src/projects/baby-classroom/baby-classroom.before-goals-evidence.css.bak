@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;600;700;800&display=swap');

.baby-classroom-page{--bg:#fbfdff;--bg-sky:#f2faff;--bg-sky-deep:#eaf7ff;--ink:#1e3147;--ink-strong:#20364c;--muted:#5f748b;--blue:#65b8ff;--yellow:#ffd84d;--green:#5edb75;--border:rgba(56,110,151,.16);--border-light:rgba(255,255,255,.72);--radius-s:18px;--radius-m:28px;--radius-l:42px;--shadow-s:0 10px 28px rgba(49,108,151,.08);--shadow-m:0 22px 52px rgba(49,108,151,.13);--shadow-l:0 34px 78px rgba(38,92,130,.17);--content:1240px;--section-space:clamp(96px,11vw,170px);--font-display:'Smiley Sans','MiSans','HarmonyOS Sans SC','Noto Sans SC',sans-serif;--font-body:'MiSans','HarmonyOS Sans SC','Noto Sans SC',sans-serif;--font-ui:Manrope,'MiSans','HarmonyOS Sans SC','Noto Sans SC',sans-serif;position:fixed;z-index:20;inset:0;display:block;min-height:100svh;overflow:auto;isolation:isolate;background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:16px;line-height:1.6;opacity:1;visibility:visible}.baby-classroom-page,.baby-classroom-page *{box-sizing:border-box}
.baby-classroom-page__back{position:fixed;z-index:200;top:24px;left:24px;display:inline-flex;align-items:center;gap:9px;min-height:46px;padding:0 18px;border:0;border-radius:999px;background:rgba(14,25,38,.88);color:#fff;font:600 15px/1 var(--font-body);cursor:pointer;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transition:background .18s ease-out,transform .18s ease-out}.baby-classroom-page__back>span{transition:transform .18s ease-out}.baby-classroom-page__back:hover{background:rgba(31,55,79,.94)}.baby-classroom-page__back:hover>span{transform:translateX(-2px)}.baby-classroom-page__back:active{transform:scale(.97)}.baby-classroom-page__back:focus-visible{outline:3px solid rgba(101,184,255,.62);outline-offset:4px}
@scope (.baby-classroom-page) {

:root{--bg:#fbfdff;--bg-sky:#f2faff;--bg-sky-deep:#eaf7ff;--ink:#1e3147;--ink-strong:#20364c;--muted:#5f748b;--blue:#65b8ff;--yellow:#ffd84d;--green:#5edb75;--border:rgba(56,110,151,.16);--border-light:rgba(255,255,255,.72);--radius-s:18px;--radius-m:28px;--radius-l:42px;--shadow-s:0 10px 28px rgba(49,108,151,.08);--shadow-m:0 22px 52px rgba(49,108,151,.13);--shadow-l:0 34px 78px rgba(38,92,130,.17);--content:1240px;--section-space:clamp(96px,11vw,170px);--font-display:'Smiley Sans','得意黑','MiSans','HarmonyOS Sans SC','Noto Sans SC',sans-serif;--font-body:'MiSans','HarmonyOS Sans SC','Noto Sans SC',sans-serif;--font-ui:Manrope,'MiSans','HarmonyOS Sans SC','Noto Sans SC',sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:16px;line-height:1.6}h1,h2,h3,p{margin:0}h1,h2{letter-spacing:-.065em}.content,.hero-inner{width:min(var(--content),calc(100% - 96px));margin:auto}.section{position:relative;overflow:hidden}.eyebrow{font:800 13px/1.25 var(--font-ui);letter-spacing:.14em;color:var(--blue)}.body-copy{font:400 16px/1.9 var(--font-body);color:var(--muted);max-width:460px}.title-reveal{overflow:hidden}.title-reveal h2{font:800 clamp(44px,5vw,76px)/1.1 var(--font-display);color:var(--ink-strong)}.title-reveal h2 span{color:var(--blue)}.glass{background:rgba(255,255,255,.56);border:1px solid var(--border-light);box-shadow:var(--shadow-m);backdrop-filter:blur(16px)}

.progress-track{position:fixed;z-index:30;left:0;top:0;height:100vh;width:3px;background:rgba(101,184,255,.12)}.progress-track i{display:block;height:100%;width:100%;background:var(--blue);transform-origin:top}.side-nav{position:fixed;z-index:30;right:30px;top:50%;transform:translateY(-50%);display:grid;gap:13px}.side-nav a{display:flex;align-items:center;justify-content:flex-end;gap:8px;text-decoration:none;color:#627d95;font:700 13px/1 var(--font-ui);letter-spacing:.1em}.side-nav b{font:600 13px/1 var(--font-ui);color:#7f98ad}.side-nav span{width:0;opacity:0;overflow:hidden;transition:width .28s ease,opacity .2s ease}.side-nav a:after{content:'';width:6px;height:6px;border-radius:999px;background:#c7d9e7;transition:.28s}.side-nav a:hover,.side-nav a:focus-visible,.side-nav a.active{color:var(--blue)}.side-nav a.active span{width:78px;opacity:1}.side-nav a.active:after{width:18px;background:var(--blue)}.side-nav a:focus-visible,.primary-btn:focus-visible{outline:3px solid rgba(101,184,255,.42);outline-offset:4px}

.hero{min-height:100svh;display:grid;align-items:center;position:relative;overflow:hidden;isolation:isolate;background:linear-gradient(135deg,var(--bg) 0%,var(--bg-sky) 54%,#f8fcff 100%)}.hero:before{content:'';position:absolute;inset:0;z-index:-1;background-image:radial-gradient(rgba(101,184,255,.13) .55px,transparent .65px);background-size:14px 14px;opacity:.32}.hero-glow{position:absolute;z-index:-1;border-radius:50%;pointer-events:none}.hero-glow-blue{width:min(43vw,680px);height:min(43vw,680px);right:-11vw;top:-23vw;background:radial-gradient(circle,rgba(163,218,255,.66),rgba(212,241,255,.21) 42%,transparent 70%)}.hero-glow-green{width:min(35vw,530px);height:min(35vw,530px);left:-17vw;bottom:-21vw;background:radial-gradient(circle,rgba(94,219,117,.12),transparent 70%)}.hero-inner{min-height:100svh;display:grid;grid-template-columns:.91fr 1.09fr;align-items:center;gap:40px;padding:100px 0 94px}.hero-copy{position:relative;z-index:1}.hero-kicker{margin-bottom:27px}.hero-title-mask{overflow:hidden;padding:7px 0}.hero h1{font:700 clamp(65px,7.4vw,116px)/.94 var(--font-display);color:var(--ink-strong);text-wrap:balance}.subtitle{margin-top:25px;font:700 23px/1.35 var(--font-body);color:var(--ink-strong)}.intro{margin-top:12px;color:var(--muted);font:400 16px/1.85 var(--font-body)}.meta-row{display:flex;gap:28px;margin-top:34px}.meta-row span{display:grid;gap:6px;color:#425d75;font:700 13px/1.3 var(--font-body)}.meta-row b{color:#7690a6;font:800 13px/1 var(--font-ui);letter-spacing:.12em}.primary-btn{margin-top:36px;display:inline-flex;align-items:center;gap:23px;min-height:52px;padding:14px 19px 14px 25px;border-radius:999px;background:var(--blue);color:white;text-decoration:none;font:800 14px/1 var(--font-ui);box-shadow:0 14px 28px rgba(73,157,226,.26)}.button-arrow{display:block;width:17px;height:10px;position:relative}.button-arrow:before{content:'';position:absolute;left:0;top:4px;width:15px;border-top:1.5px solid currentColor;transition:transform .22s ease}.button-arrow:after{content:'';position:absolute;right:0;top:1px;width:7px;height:7px;border-top:1.5px solid currentColor;border-right:1.5px solid currentColor;transform:rotate(45deg);transition:transform .22s ease}.primary-btn:hover .button-arrow:before,.primary-btn:hover .button-arrow:after{transform:translateX(4px)}.primary-btn:hover .button-arrow:after{transform:translateX(4px) rotate(45deg)}.hero-stage{height:min(69vh,680px);min-height:470px;position:relative;display:grid;place-items:center}.hero-main-mockup{height:100%;width:100%;position:relative;z-index:2;will-change:transform}.hero-main-mockup img,.hero-back-screen img{width:100%;height:100%;object-fit:contain;display:block}.hero-main-mockup img{filter:drop-shadow(0 34px 36px rgba(47,100,137,.22))}.hero-back-screen{position:absolute;z-index:1;height:67%;width:46%;right:7%;top:6%;padding:9px;border-radius:31px;background:rgba(255,255,255,.45);border:1px solid rgba(255,255,255,.78);box-shadow:var(--shadow-s);overflow:hidden}.hero-back-screen img{opacity:.78}.stage-line{position:absolute;z-index:0;border:1px solid rgba(101,184,255,.3);border-radius:50%;pointer-events:none}.stage-line-one{width:82%;height:34%;right:-4%;top:11%;transform:rotate(-26deg)}.stage-line-two{width:48%;height:18%;left:2%;bottom:13%;transform:rotate(23deg);border-color:rgba(94,219,117,.2)}.scroll-cue{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);z-index:2;display:grid;grid-template-columns:auto auto auto;align-items:center;gap:8px;text-decoration:none;color:#6b859a;font:700 13px/1 var(--font-ui);letter-spacing:.1em}.scroll-line{grid-row:span 2;width:1px;height:34px;background:#8cccf8;position:relative;overflow:hidden}.scroll-line:after{content:'';position:absolute;left:0;width:1px;height:12px;background:white;animation:scroll-indicator 1.7s ease-in-out infinite}.scroll-cue b{color:var(--blue)}.scroll-cue em{font-style:normal;color:#92a6b5}.scroll-cue small{grid-column:2 / 4;font:700 13px/1 var(--font-body);letter-spacing:.08em}@keyframes scroll-indicator{from{top:-12px}to{top:34px}}

.overview{padding:var(--section-space) 0;background:linear-gradient(150deg,#fff 0%,var(--bg-sky) 100%)}.overview-grid{display:grid;grid-template-columns:.16fr .98fr .86fr;gap:38px;align-items:center}.overview-number{font:800 clamp(90px,12vw,180px)/1 var(--font-ui);color:#e3f4ff;letter-spacing:-.1em;writing-mode:vertical-rl}.overview-copy .eyebrow{margin-bottom:24px}.overview-copy .body-copy{margin:28px 0 37px}.overview-copy dl{margin:0}.overview-copy dl>div{border-top:1px solid var(--border);padding:15px 0;display:flex;justify-content:space-between;font-size:14px}.overview-copy dt{color:#7890a5}.overview-copy dd{margin:0;font-weight:800}.overview-visual{height:540px;border-radius:var(--radius-l);display:grid;place-items:center;position:relative;overflow:hidden}.overview-visual:before{content:'';position:absolute;width:240px;height:240px;border-radius:50%;background:rgba(101,184,255,.16);top:-60px;right:-55px}.overview-visual img{position:relative;width:91%;height:91%;object-fit:contain}
.goals{padding:var(--section-space) 0 calc(var(--section-space) + 30px);background:var(--bg-sky)}.goals:after{content:'';height:100px;width:100%;position:absolute;bottom:-52px;background:var(--bg);border-radius:50% 50% 0 0/100% 100% 0 0}.goals-heading{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-top:22px}.goals-heading>p{color:var(--muted);max-width:260px;line-height:1.8;font-size:14px}.goal-grid{display:grid;grid-template-columns:1.2fr .8fr .8fr;grid-template-rows:210px 210px;gap:18px;margin-top:54px}.goal-card{background:rgba(255,255,255,.7);border:1px solid var(--border-light);padding:28px;border-radius:var(--radius-m);box-shadow:var(--shadow-s);position:relative;overflow:hidden}.goal-card.wide{grid-row:span 2;background:linear-gradient(145deg,#fff,#e2f4ff)}.goal-card.tall{grid-row:span 2}.goal-card span{font:800 13px/1 var(--font-ui);color:var(--blue)}.goal-card h3{font-size:25px;margin-top:34px}.goal-card p{color:#607b92;line-height:1.75;font-size:14px;max-width:220px;margin-top:11px}.goal-card i{position:absolute;right:25px;bottom:18px;font-style:normal;font-size:35px;color:rgba(101,184,255,.28)}.goal-card.wide i{font-size:80px;color:rgba(255,216,77,.75)}
.experience{padding:var(--section-space) 0}.experience-layout{display:grid;grid-template-columns:.7fr 1.3fr;gap:85px}.experience-copy{position:sticky;top:22vh;height:max-content}.experience-copy .eyebrow{margin-bottom:23px}.experience-copy .body-copy{margin-top:24px}.experience-index{display:grid;gap:10px;margin-top:40px}.experience-index span{font:700 13px/1.3 var(--font-ui);color:#7890a5}.experience-gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:70px 24px;padding:15px 0}.experience-screen:nth-child(2n){transform:translateY(100px)}.experience-screen{margin:0}.experience-screen>div{height:435px;border:8px solid #fff;border-radius:31px;background:linear-gradient(135deg,#eef9ff,#fff);box-shadow:var(--shadow-m);overflow:hidden}.experience-screen img{width:100%;height:100%;object-fit:contain;transition:transform .45s}.experience-screen:hover img{transform:scale(1.025)}.experience-screen figcaption{font:800 13px/1.3 var(--font-body);margin-top:15px;text-align:center;color:#55718a}
.motion-section{background:#1c334b;color:#fff;padding:var(--section-space) 0;isolation:isolate}.motion-section .content{position:relative;z-index:1}.motion-section .eyebrow{color:#8fd0ff}.motion-section .title-reveal{margin-top:23px}.motion-section .title-reveal h2{color:#fff}.motion-section .title-reveal h2 span{color:var(--yellow)}.motion-section .body-copy{color:#bed0dd;margin-top:25px}.motion-orb{position:absolute;width:600px;height:600px;right:-260px;top:-170px;border-radius:50%;border:1px solid rgba(157,216,255,.18);box-shadow:0 0 0 70px rgba(157,216,255,.035),0 0 0 140px rgba(157,216,255,.025)}.video-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:17px;margin-top:54px}.video-card{margin:0;border-radius:23px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);overflow:hidden;position:relative;transition:transform .3s,background .3s}.video-card:hover{transform:translateY(-6px);background:rgba(255,255,255,.12)}.video-card video{width:100%;height:255px;display:block;background:#15293e;object-fit:contain}.video-card p{font:700 14px/1.4 var(--font-body);padding:16px}.video-dot{position:absolute;right:15px;bottom:20px;width:7px;height:7px;border-radius:50%;background:var(--green)}
.design-system{padding:var(--section-space) 0;background:linear-gradient(160deg,#fff 30%,var(--bg-sky))}.design-system .title-reveal{margin-top:22px}.system-grid{display:grid;grid-template-columns:.9fr .9fr 1.2fr;gap:18px;margin-top:57px}.system-grid article{min-height:257px;border-radius:var(--radius-m);background:rgba(255,255,255,.72);border:1px solid var(--border);box-shadow:var(--shadow-s);padding:30px}.system-grid b{color:var(--blue);font:800 13px/1 var(--font-ui);letter-spacing:.14em}.system-grid p{font-size:13px;color:#71869b;line-height:1.7}.colors{display:flex;gap:9px;margin:38px 0 25px}.colors i{height:47px;width:47px;border-radius:50%;display:block;border:1px solid var(--border);transition:transform .25s}.colors i:hover{transform:translateY(-8px)}.blue{background:var(--blue)}.yellow{background:var(--yellow)}.green{background:var(--green)}.white{background:#fff}.type-preview{height:134px;display:grid;align-content:center;gap:8px}.type-preview strong{font:700 28px/1.2 var(--font-display);color:#27435c}.type-preview span{font:600 13px/1.4 var(--font-ui);letter-spacing:.06em;color:#63819b}.component-preview{height:134px;display:flex;align-items:center;gap:12px}.component-preview button{border:0;background:var(--blue);border-radius:99px;color:white;padding:12px 19px;font:700 13px var(--font-body)}.component-preview span{font-size:13px;background:#fff;border-radius:14px;padding:14px;box-shadow:var(--shadow-s)}.component-preview i{font-style:normal;color:#fff;background:var(--green);width:25px;height:25px;border-radius:50%;display:grid;place-items:center}
.final-demo{padding:var(--section-space) 0 0;background:radial-gradient(circle at 84% 32%,#d7f2ff 0,transparent 25%),linear-gradient(135deg,var(--bg-sky),#fff)}.final-inner{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:80px}.final-inner .title-reveal{margin-top:22px}.final-inner .body-copy{margin-top:26px}.final-phone{height:520px;filter:drop-shadow(0 30px 28px rgba(74,136,170,.2))}.final-phone img{width:100%;height:100%;object-fit:contain}footer{width:min(var(--content),calc(100% - 96px));margin:80px auto 0;padding:25px 0;border-top:1px solid var(--border);color:#7290a5;font:700 13px/1 var(--font-ui);display:flex;justify-content:space-between}
@media(max-width:1000px){.side-nav,.progress-track{display:none}.content,.hero-inner,footer{width:min(100% - 48px,780px)}.hero-inner,.overview-grid,.experience-layout,.final-inner{grid-template-columns:1fr}.hero-inner{padding:110px 0 80px}.hero-stage{height:500px;min-height:0}.hero-main-mockup{transform:none!important}.overview-grid{gap:38px}.overview-number{writing-mode:initial;font-size:100px}.overview-visual{height:460px}.goal-grid{grid-template-columns:1fr 1fr;grid-template-rows:220px 220px 220px}.goal-card.wide,.goal-card.tall{grid-row:span 1}.experience-copy{position:static}.experience-gallery{margin-top:15px}.video-grid{grid-template-columns:repeat(2,1fr)}.system-grid{grid-template-columns:1fr 1fr}.component-card{grid-column:span 2}}
@media(max-width:600px){.content,.hero-inner,footer{width:calc(100% - 40px)}.hero-inner{gap:26px;padding-top:94px}.hero h1{font-size:62px}.subtitle{font-size:20px}.meta-row{gap:17px;flex-wrap:wrap}.hero-stage{height:390px}.hero-back-screen{height:57%;width:43%;right:0}.stage-line{display:none}.scroll-cue{display:none}.overview-visual{height:380px}.goals-heading{display:block}.goals-heading>p{margin-top:21px}.goal-grid,.system-grid,.video-grid{grid-template-columns:1fr}.goal-grid{grid-template-rows:none}.goal-card{min-height:185px}.component-card{grid-column:auto}.experience-gallery{grid-template-columns:1fr;gap:36px}.experience-screen:nth-child(2n){transform:none}.experience-screen>div{height:400px}.video-card video{height:250px}.final-inner{gap:25px}.final-phone{height:410px}footer{margin-top:40px}.title-reveal h2{font-size:45px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}.hero-main-mockup{transform:none!important}}

/* Readability pass: device media keeps its natural vertical ratio inside a controlled stage. */
@media(min-width:1001px){.hero-inner{width:min(1120px,calc(100% - 280px));grid-template-columns:minmax(390px,.88fr) minmax(480px,1.12fr);gap:56px}.hero-stage{height:min(66vh,620px);min-height:450px}.hero-main-mockup{max-width:540px;justify-self:center}.hero-back-screen{width:54%;height:73%;right:-1%;top:8%;padding:12px}.stage-line{display:none}.side-nav{right:20px}}
.motion-section{background:linear-gradient(145deg,#1c334b,#233f59)}.motion-orb{display:none}.motion-showcase{display:grid;grid-template-columns:minmax(340px,1fr) minmax(470px,1.3fr);gap:54px;align-items:center;margin-top:58px}.motion-supporting{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:end}.video-card{background:transparent;border:0;border-radius:0;overflow:visible;transition:none}.video-card:hover{transform:none;background:transparent}.video-frame{position:relative;margin:auto;width:100%;aspect-ratio:9/16;max-width:270px;border-radius:25px;overflow:hidden;background:#294a66;border:1px solid rgba(205,235,255,.22);box-shadow:0 22px 46px rgba(4,17,30,.3)}.video-card video{width:100%;height:100%;object-fit:contain;background:#294a66}.video-card-featured .video-frame{max-width:390px;max-height:700px;border-radius:34px;box-shadow:0 30px 70px rgba(4,17,30,.4)}.video-card p{padding:15px 2px 0;color:#d9e8f2;font:700 14px/1.4 var(--font-body);text-align:center}.video-card-featured p{font-size:16px;text-align:left;padding-left:7px}.video-preview-button{position:absolute;left:50%;bottom:13px;transform:translateX(-50%);padding:9px 13px;border:1px solid rgba(255,255,255,.5);border-radius:999px;background:rgba(25,52,75,.75);backdrop-filter:blur(8px);color:#fff;font:700 13px/1 var(--font-body);opacity:0;transition:opacity .2s}.video-frame:hover .video-preview-button,.video-preview-button:focus-visible{opacity:1}.media-preview{position:fixed;inset:0;z-index:100;background:rgba(13,28,42,.77);display:grid;place-items:center;padding:32px;backdrop-filter:blur(10px)}.media-preview-panel{width:min(92vw,980px);height:min(88vh,850px);position:relative;display:grid;place-items:center}.media-preview-panel video,.media-preview-panel img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;border-radius:20px;box-shadow:var(--shadow-l)}.preview-close{position:absolute;z-index:2;right:0;top:-40px;border:0;border-radius:999px;background:#fff;color:var(--ink);padding:9px 14px;font:700 13px/1 var(--font-body);cursor:pointer}
.experience{padding:var(--section-space) 0}.experience-intro{max-width:620px}.experience-intro .eyebrow{margin-bottom:23px}.experience-intro .body-copy{margin-top:24px}.map-story{display:grid;grid-template-columns:.86fr 1.14fr;gap:clamp(56px,9vw,140px);margin-top:75px;align-items:start}.map-steps{padding-bottom:28vh}.map-steps article{min-height:58vh;display:flex;flex-direction:column;justify-content:center;border-left:1px solid var(--border);padding:0 0 0 24px;opacity:.38;transition:opacity .35s,border-color .35s}.map-steps article.active{opacity:1;border-color:var(--blue)}.map-steps span{font:800 13px/1 var(--font-ui);letter-spacing:.1em;color:var(--blue)}.map-steps h3{margin-top:14px;font:800 clamp(29px,3vw,44px)/1.18 var(--font-display);color:var(--ink-strong)}.map-steps p{margin-top:13px;max-width:310px;color:var(--muted);font:400 16px/1.8 var(--font-body)}.map-stage{position:sticky;top:14vh;display:grid;justify-items:center;gap:17px}.map-phone{width:min(100%,430px);height:min(71vh,670px);border:9px solid #fff;border-radius:37px;overflow:hidden;background:var(--bg-sky-deep);box-shadow:var(--shadow-l)}.map-phone img{width:100%;height:auto;display:block;object-fit:contain;will-change:transform}.map-preview-button{border:1px solid var(--border);border-radius:999px;background:rgba(255,255,255,.78);padding:11px 17px;color:var(--ink-strong);font:700 13px/1 var(--font-body);box-shadow:var(--shadow-s);cursor:pointer}.experience-screen-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:48px;padding-top:48px;border-top:1px solid var(--border)}.experience-screen-strip figure{margin:0}.experience-screen-strip figure>div{height:340px;border:7px solid #fff;border-radius:26px;background:var(--bg-sky);box-shadow:var(--shadow-s);overflow:hidden}.experience-screen-strip img{width:100%;height:100%;object-fit:contain}.experience-screen-strip figcaption{margin-top:12px;text-align:center;color:#55718a;font:700 13px/1.3 var(--font-body)}
@media(max-width:1000px){.motion-showcase{grid-template-columns:1fr;gap:38px}.motion-supporting{max-width:720px;width:100%;justify-self:center}.video-card-featured .video-frame{max-width:360px}.map-story{grid-template-columns:1fr;gap:36px}.map-steps{padding-bottom:0;display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.map-steps article{min-height:0;padding:0 0 0 12px}.map-steps h3{font-size:20px}.map-steps p{display:none}.map-stage{position:relative;top:auto}.experience-screen-strip{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.hero-back-screen{width:51%;height:61%;right:-3%;top:9%}.hero-main-mockup{max-width:100%;height:94%}.motion-showcase{margin-top:40px}.motion-supporting{grid-template-columns:1fr;gap:28px}.video-card .video-frame{max-width:270px}.video-card-featured .video-frame{max-width:320px}.video-preview-button{opacity:1}.media-preview{padding:20px}.media-preview-panel{width:100%;height:min(82vh,700px)}.map-story{margin-top:48px}.map-steps{display:block}.map-steps article{min-height:auto;margin:0 0 34px;padding-left:16px;opacity:1}.map-steps p{display:block}.map-phone{height:570px;width:min(100%,350px);border-width:7px}.experience-screen-strip{grid-template-columns:1fr 1fr;gap:14px}.experience-screen-strip figure>div{height:250px}.map-preview-button{min-height:44px}}
@media(prefers-reduced-motion:reduce){.map-steps article{opacity:1}.map-phone{overflow:auto}.map-phone img{transform:none!important}.video-preview-button{opacity:1}}

/* Motion section: one readable primary device, then supporting evidence. */
.motion-section{padding:var(--section-space) 0;background:#1c334b}.motion-section .eyebrow{margin:0}.motion-title{margin-top:22px;color:#fff;font:800 clamp(44px,5vw,76px)/1.1 var(--font-display);letter-spacing:-.065em}.motion-title span{color:var(--yellow)}.motion-section .body-copy{margin-top:22px}.motion-showcase{grid-template-columns:minmax(400px,.96fr) minmax(560px,1.32fr);gap:72px;align-items:center}.motion-primary{display:grid;justify-items:center}.motion-supporting{align-items:start}.motion-supporting>div:nth-child(2){margin-top:52px}.motion-supporting>div:nth-child(3){margin-top:104px}.video-frame{background:#284861}.video-card-featured .video-frame{width:min(100%,390px);max-width:none;height:min(73vh,680px);aspect-ratio:auto;border-radius:30px}.video-card-featured .video-frame video{object-fit:contain}.motion-supporting .video-frame{width:min(100%,210px);max-width:none;height:370px;aspect-ratio:auto;border-radius:23px}.motion-supporting .video-frame video{object-fit:contain}.video-caption{margin:14px auto 0;width:min(100%,390px);display:flex;align-items:center;justify-content:space-between;gap:10px}.video-card p,.video-card-featured p{margin:0;padding:0;text-align:left;color:#dcebf4;font:700 14px/1.35 var(--font-body)}.video-card-featured p{font-size:16px}.video-actions{display:flex;gap:5px}.video-actions button{min-width:44px;min-height:36px;padding:7px 9px;border:1px solid rgba(220,235,244,.26);border-radius:999px;background:transparent;color:#c8dbe8;font:700 13px/1 var(--font-body);cursor:pointer;transition:border-color .15s ease,color .15s ease}.video-actions button:hover,.video-actions button:focus-visible{border-color:#8fd0ff;color:#fff}.video-preview-button{min-height:44px}.media-preview{z-index:100}.preview-close{min-height:44px}.video-frame:hover{box-shadow:0 24px 55px rgba(4,17,30,.38)}
@media(max-width:1100px){.motion-showcase{grid-template-columns:1fr;gap:44px}.motion-supporting{grid-template-columns:repeat(3,1fr);max-width:760px;align-items:start}.motion-supporting>div:nth-child(2),.motion-supporting>div:nth-child(3){margin-top:0}.motion-supporting .video-frame{height:340px;max-width:210px}.video-caption{max-width:210px;align-items:flex-start;flex-direction:column}.video-actions{width:100%}.video-actions button{flex:1}.video-card-featured .video-caption{max-width:390px;align-items:center;flex-direction:row}}
@media(max-width:600px){.motion-showcase{gap:36px}.video-card-featured .video-frame{width:min(100%,330px);height:590px}.video-card-featured .video-caption{width:min(100%,330px);align-items:flex-start;flex-direction:column}.motion-supporting{grid-template-columns:1fr;max-width:100%;gap:31px}.motion-supporting .video-frame{height:440px;max-width:250px}.motion-supporting .video-caption{max-width:250px;align-items:center;flex-direction:row}.video-actions button{min-height:44px}.video-preview-button{opacity:1}.motion-title{font-size:44px}}
@media(prefers-reduced-motion:reduce){.motion-section .video-frame{transition:none}.motion-section .video-frame:hover{box-shadow:0 22px 46px rgba(4,17,30,.3)}}

/* GIF media replaces MP4 in the Motion case study. */
.motion-section .video-frame img{width:100%;height:100%;display:block;object-fit:contain;background:#284861}.motion-section .video-caption{justify-content:flex-start}.motion-section .video-actions{display:none}

/* Hero contains one visual subject only: the primary case-study mockup. */
@media(min-width:1001px){.hero-inner{width:min(1100px,calc(100% - 300px));grid-template-columns:minmax(400px,.9fr) minmax(460px,1.1fr);gap:64px}.hero-stage{height:min(65vh,600px);min-height:440px;justify-items:center}.hero-main-mockup{width:min(100%,500px);height:100%;max-width:500px;overflow:visible}.hero-main-mockup img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 26px 28px rgba(47,100,137,.18))}.side-nav{right:24px}}
@media(max-width:1000px){.hero-stage{height:480px}.hero-main-mockup{max-width:460px}}
@media(max-width:600px){.hero-stage{height:380px}.hero-main-mockup{height:100%;max-width:100%}}
@media(max-width:600px){.baby-classroom-page__back{top:max(14px,env(safe-area-inset-top));left:14px;min-height:44px;padding:0 16px}}

/* Density pass: keep the case study visible and readable throughout the scroll. */
.baby-classroom-page{--section-space:clamp(110px,9vw,140px)}
.hero-stage{height:clamp(500px,66vh,720px);min-height:500px}.hero-main-mockup{max-width:520px}
.goals{padding-block:120px}.goal-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:none;gap:0;margin-top:48px;border-top:1px solid var(--border)}.goal-card,.goal-card.wide,.goal-card.tall{min-height:210px;padding:30px 28px;background:transparent;border:0;border-radius:0;box-shadow:none;border-bottom:1px solid var(--border)}.goal-card:nth-child(odd){border-right:1px solid var(--border);padding-right:48px}.goal-card:nth-child(even){padding-left:48px}.goal-card h3{margin-top:22px}.goal-card p{max-width:290px}.goal-card i,.goal-card.wide i{right:18px;bottom:18px;font-size:28px;color:rgba(101,184,255,.32)}
.experience{padding-block:120px}.map-story{gap:clamp(48px,7vw,96px);margin-top:54px}.map-steps{padding-bottom:0}.map-steps article{min-height:34vh;opacity:.5}.map-steps article:first-child{min-height:30vh}.map-steps article.active{opacity:1}.map-phone{width:min(100%,620px);height:min(72vh,680px)}.experience-screen-strip{grid-template-columns:1.35fr .82fr .82fr;gap:24px;margin-top:56px;padding-top:40px}.experience-screen-strip figure>div{height:360px}.experience-screen-strip figure:first-child>div{height:500px}.experience-screen-strip figure:first-child{grid-row:span 1}.experience-screen-strip figcaption{text-align:left}
.motion-section{padding-block:120px}.motion-showcase{margin-top:64px}.motion-section .body-copy{max-width:560px}.motion-primary{justify-items:start}.video-card-featured .video-frame{width:min(100%,420px);height:min(72vh,690px)}.motion-supporting{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.motion-supporting>div:nth-child(3){grid-column:1 / -1;justify-self:center}.motion-supporting>div:nth-child(2),.motion-supporting>div:nth-child(3){margin-top:0}.motion-supporting .video-frame{width:min(100%,290px);height:460px}.video-caption:before{content:'即时反馈';color:#8fd0ff;font:800 11px/1 var(--font-ui);letter-spacing:.08em}
.design-system{padding-block:120px}.system-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin-top:42px}.system-grid article{min-height:280px;padding:30px 0;background:transparent;border:0;border-top:1px solid var(--border);border-radius:0;box-shadow:none}.colors{margin:32px 0 22px}.colors i{width:60px;height:60px}.final-demo{min-height:0;padding:140px 0 0}.final-inner{grid-template-columns:minmax(0,4fr) minmax(0,7fr);gap:64px}.final-phone{width:clamp(420px,34vw,600px);height:auto;justify-self:end}.final-phone img{height:auto;object-fit:contain}
.side-nav a{opacity:.28}.side-nav a.active,.side-nav a:hover,.side-nav a:focus-visible{opacity:1}

@media(max-width:1000px){.goal-grid{grid-template-columns:1fr 1fr}.experience-screen-strip{grid-template-columns:repeat(3,1fr)}.experience-screen-strip figure:first-child>div,.experience-screen-strip figure>div{height:360px}.system-grid{grid-template-columns:repeat(3,1fr)}.final-phone{width:min(100%,520px)}}
@media(max-width:600px){.hero-stage{height:500px;min-height:0}.goals,.experience,.motion-section,.design-system{padding-block:96px}.goal-grid,.system-grid{grid-template-columns:1fr}.goal-card:nth-child(odd),.goal-card:nth-child(even){padding:26px 0;border-right:0}.experience-screen-strip{grid-template-columns:1fr;gap:28px}.experience-screen-strip figure:first-child>div,.experience-screen-strip figure>div{height:auto;min-height:0}.motion-supporting{grid-template-columns:1fr}.motion-supporting>div:nth-child(3){grid-column:auto}.motion-primary,.motion-supporting>div{justify-items:center}.system-grid article{min-height:0;padding:26px 0}.final-inner{grid-template-columns:1fr;gap:44px}.final-phone{width:min(100%,420px);justify-self:center}}

/* Image axis pass: every desktop image module follows the same 12-column frame. */
@media(min-width:1001px){
  .hero-inner,.experience .content,.motion-section .content,.design-system .content,.final-demo .content{width:min(1440px,calc(100vw - 96px));}
  .hero-inner{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;gap:0;}
  .hero-copy{grid-column:2 / span 4;min-width:0;}
  .hero-stage{grid-column:7 / span 5;width:100%;height:clamp(500px,66vh,700px);min-height:0;justify-self:center;align-self:center;}
  .hero-main-mockup{width:auto;height:100%;max-width:100%;justify-self:center;}
  .hero-main-mockup{display:grid;place-items:start center;overflow:hidden;}
  .hero-main-mockup img{width:112%;height:auto;max-width:none;object-fit:contain;}

  .map-story{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;gap:0;margin-top:64px;align-items:center;}
  .map-steps{grid-column:2 / span 4;min-width:0;padding-bottom:0;}
  .map-steps article,.map-steps article:first-child{min-height:34vh;}
  .map-stage{grid-column:7 / span 5;width:100%;position:sticky;top:14vh;justify-self:start;align-self:center;justify-items:start;}
  .map-phone{width:100%;max-width:560px;height:min(70vh,650px);}

  .experience-screen-strip{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;row-gap:32px;align-items:center;}
  .experience-screen-strip figure{transform:none!important;min-width:0;}
  .experience-screen-strip figure:nth-child(1){grid-column:2 / span 5;}
  .experience-screen-strip figure:nth-child(2){grid-column:8 / span 2;}
  .experience-screen-strip figure:nth-child(3){grid-column:10 / span 2;}
  .experience-screen-strip figure:first-child>div{height:520px;}
  .experience-screen-strip figure:nth-child(n+2)>div{height:300px;}

  .motion-showcase{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;row-gap:36px;align-items:center;margin-top:72px;}
  .motion-primary{grid-column:2 / span 4;width:100%;justify-items:start;}
  .motion-supporting{grid-column:7 / span 5;width:100%;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));column-gap:24px;row-gap:34px;align-items:start;}
  .motion-supporting>div:nth-child(1){grid-column:1 / span 2;}
  .motion-supporting>div:nth-child(2){grid-column:4 / span 2;}
  .motion-supporting>div:nth-child(3){grid-column:2 / span 2;justify-self:center;}
  .motion-supporting>div:nth-child(2),.motion-supporting>div:nth-child(3){margin-top:0;}
  .video-card-featured .video-frame{width:clamp(380px,30vw,520px);height:min(72vh,690px);}
  .motion-supporting .video-frame{width:clamp(220px,17vw,300px);height:460px;}

  .system-grid{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;gap:0;margin-top:56px;}
  .system-grid article:nth-child(1){grid-column:2 / span 3;}
  .system-grid article:nth-child(2){grid-column:5 / span 4;}
  .system-grid article:nth-child(3){grid-column:9 / span 3;}

  .final-inner{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;gap:0;align-items:center;}
  .final-inner>div:first-child{grid-column:2 / span 4;min-width:0;}
  .final-phone{grid-column:7 / span 5;width:clamp(430px,35vw,600px);max-width:100%;height:auto;justify-self:start;align-self:center;}
}

/* DESIGN GOALS: compact evidence-led matrix, not a dashboard of oversized cards. */
.goals{padding-block:clamp(104px,9vw,144px);background:var(--bg-sky)}
.goals-content{width:min(1380px,calc(100vw - 96px));margin-inline:auto}
.goals-header{display:flex;align-items:end;justify-content:space-between;gap:48px}
.goals-header .eyebrow{margin-bottom:18px}
.goals-header .title-reveal h2{font-size:clamp(48px,5vw,76px);line-height:1.08}
.goals-header>div:last-child{max-width:420px;margin-bottom:8px;color:var(--muted);font:400 16px/1.8 var(--font-body)}
.goal-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;margin-top:64px;border:0}
.goal-card,.goal-card.wide,.goal-card.tall{grid-column:span 6;min-height:310px;padding:30px 32px;border:1px solid rgba(56,110,151,.16);border-radius:22px;box-shadow:none;overflow:hidden;position:relative;background:rgba(255,255,255,.44);transition:background .42s ease,border-color .42s ease}
.goal-card:nth-child(odd),.goal-card:nth-child(even){border-right:1px solid rgba(56,110,151,.16);padding:30px 32px}
.goal-card--learning{background:rgba(232,246,255,.78)}
.goal-card--companion{background:rgba(255,249,220,.76)}
.goal-card--feedback{background:rgba(235,250,241,.8)}
.goal-card--friendly{background:rgba(245,241,255,.78)}
.goal-card:hover{background:rgba(255,255,255,.82);border-color:rgba(101,184,255,.38)}
.goal-copy{position:relative;z-index:1;max-width:57%}
.goal-number{display:block;color:rgba(101,184,255,.52);font:800 clamp(32px,3vw,52px)/.9 var(--font-ui);letter-spacing:-.06em}
.goal-card h3{margin-top:22px;color:var(--ink-strong);font:800 clamp(28px,2.3vw,34px)/1.15 var(--font-display)}
.goal-card p{max-width:285px;margin-top:11px;color:var(--muted);font:400 clamp(16px,1.15vw,18px)/1.72 var(--font-body)}
.goal-proof{position:absolute;right:26px;bottom:24px;width:34%;height:35%;display:grid;place-items:end center;transition:transform .42s cubic-bezier(.22,1,.36,1)}
.goal-proof img{display:block;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 10px 14px rgba(49,108,151,.08))}
.goal-card--learning .goal-proof{width:38%;height:32%;right:20px;bottom:20px}
.goal-card--companion .goal-proof{height:49%;width:31%;right:20px;bottom:12px}
.goal-card--feedback .goal-proof{width:37%;height:31%;right:20px;bottom:22px}
.goal-card--friendly .goal-proof{width:39%;height:31%;right:20px;bottom:24px}
.goal-card:hover .goal-proof{transform:translateY(-4px) scale(1.015)}
.side-nav a:not(.active){opacity:.22}
.side-nav a.active{opacity:1}
@media(max-width:1000px){.goals-content{width:min(100% - 48px,900px)}.goals-header{align-items:start;flex-direction:column;gap:20px}.goals-header>div:last-child{margin:0}.goal-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.goal-card,.goal-card.wide,.goal-card.tall{grid-column:auto;min-height:300px}.goal-card:nth-child(odd),.goal-card:nth-child(even){padding:28px;border-right:1px solid rgba(56,110,151,.16)}}
@media(max-width:640px){.goals{padding-block:88px}.goals-content{width:calc(100% - 40px)}.goals-header .title-reveal h2{font-size:46px}.goal-grid{grid-template-columns:1fr;margin-top:52px;gap:16px}.goal-card,.goal-card.wide,.goal-card.tall{min-height:280px;padding:26px}.goal-card:nth-child(odd),.goal-card:nth-child(even){padding:26px}.goal-copy{max-width:62%}.goal-card p{font-size:16px}.goal-proof{right:18px;bottom:18px}.goal-card--companion .goal-proof{width:33%;height:46%}}
}
