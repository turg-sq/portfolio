.liquid-glass-lens{display:none}

@media (min-width:1024px) and (hover:hover) and (pointer:fine){
  .liquid-glass-lens{position:absolute;z-index:8;inset:0;display:block;overflow:hidden;pointer-events:none;opacity:0;transition:opacity .16s ease-out}
  .liquid-glass-lens[data-active="true"]{opacity:1}
  .liquid-glass-lens[data-mode="blank"]{opacity:.52}
  .liquid-glass-lens[data-mode="visual"]{opacity:.78}
  .liquid-glass-lens[data-mode="title"]{opacity:.94}
  .liquid-glass-lens__defs{position:absolute;width:0;height:0;overflow:hidden}
  .liquid-glass-lens__body{position:absolute;left:0;top:0;width:230px;height:205px;overflow:hidden;border-radius:50% 48% 52% 47% / 49% 52% 47% 51%;background:rgba(255,255,255,.045);box-shadow:inset 2px 2px 10px rgba(255,255,255,.22),inset -4px -5px 14px rgba(105,177,228,.075),0 8px 24px rgba(70,135,184,.05);will-change:transform;contain:paint}
  .liquid-glass-lens__body:after{content:'';position:absolute;inset:0;border-radius:inherit;background:radial-gradient(circle at 32% 24%,rgba(255,255,255,.16),transparent 30%),radial-gradient(circle at 72% 82%,rgba(83,190,255,.07),transparent 44%);mix-blend-mode:screen;pointer-events:none}
  .liquid-glass-lens__scene{position:absolute;inset:0;width:max-content;height:max-content;will-change:transform;pointer-events:none}
  .liquid-glass-lens__scene>.hero{position:relative;min-height:100%;overflow:hidden;pointer-events:none}
  .liquid-glass-lens__scene--edge{mask-image:radial-gradient(ellipse at center,transparent 0 59%,#000 76%,#000 100%);-webkit-mask-image:radial-gradient(ellipse at center,transparent 0 59%,#000 76%,#000 100%);opacity:.7}
  .liquid-glass-lens__scene--cyan{mask-image:radial-gradient(ellipse at center,transparent 0 67%,#000 84%,#000 100%);-webkit-mask-image:radial-gradient(ellipse at center,transparent 0 67%,#000 84%,#000 100%);opacity:.055;mix-blend-mode:screen;margin-left:1px}
  .liquid-glass-lens__scene--warm{mask-image:radial-gradient(ellipse at center,transparent 0 67%,#000 84%,#000 100%);-webkit-mask-image:radial-gradient(ellipse at center,transparent 0 67%,#000 84%,#000 100%);opacity:.045;mix-blend-mode:multiply;margin-left:-1px}
  .liquid-glass-lens__specular{position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 0 0 1px rgba(255,255,255,.12),inset 0 0 22px rgba(255,255,255,.06);pointer-events:none}
}

@media (max-width:1023px), (hover:none), (pointer:coarse), (prefers-reduced-motion:reduce){.liquid-glass-lens{display:none!important}}
