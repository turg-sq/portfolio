.liquid-glass-lens{display:none}

@media (min-width:1024px) and (hover:hover) and (pointer:fine){
  .liquid-glass-lens{position:absolute;z-index:8;inset:0;display:block;overflow:hidden;pointer-events:none;opacity:0;transition:opacity .16s ease-out}
  .liquid-glass-lens[data-active="true"]{opacity:1}
  .liquid-glass-lens[data-mode="blank"]{opacity:.22}
  .liquid-glass-lens[data-mode="visual"]{opacity:.62}
  .liquid-glass-lens[data-mode="title"]{opacity:.78}
  .liquid-glass-lens__defs{position:absolute;width:0;height:0;overflow:hidden}
  .liquid-glass-lens__body{position:absolute;left:0;top:0;width:clamp(340px,27vw,420px);height:clamp(200px,16vw,245px);overflow:hidden;border-radius:52% 47% 53% 48% / 47% 54% 46% 53%;background:rgba(255,255,255,.02);box-shadow:inset 22px 18px 34px rgba(255,255,255,.025),inset -22px -18px 30px rgba(46,104,146,.035);will-change:transform;contain:paint}
  .liquid-glass-lens__body:after{content:'';position:absolute;inset:0;border-radius:inherit;background:radial-gradient(ellipse 36% 22% at 29% 17%,rgba(255,255,255,.1),transparent 72%),radial-gradient(ellipse 32% 20% at 75% 84%,rgba(48,92,126,.05),transparent 76%);pointer-events:none}
  .liquid-glass-lens__scene{position:absolute;inset:0;width:max-content;height:max-content;will-change:transform;pointer-events:none}
  .liquid-glass-lens__scene>.hero{position:relative;min-height:100%;overflow:hidden;pointer-events:none}
  .liquid-glass-lens__scene--edge{mask-image:radial-gradient(ellipse at center,transparent 0 35%,rgba(0,0,0,.08) 52%,rgba(0,0,0,.52) 68%,#000 82%,rgba(0,0,0,.88) 94%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse at center,transparent 0 35%,rgba(0,0,0,.08) 52%,rgba(0,0,0,.52) 68%,#000 82%,rgba(0,0,0,.88) 94%,transparent 100%);opacity:.64}
  .liquid-glass-lens__scene--cyan{mask-image:radial-gradient(ellipse at center,transparent 0 70%,rgba(0,0,0,.8) 84%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse at center,transparent 0 70%,rgba(0,0,0,.8) 84%,transparent 100%);opacity:.055;mix-blend-mode:screen;margin-left:1.75px}
  .liquid-glass-lens__scene--warm{mask-image:radial-gradient(ellipse at center,transparent 0 70%,rgba(0,0,0,.8) 84%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse at center,transparent 0 70%,rgba(0,0,0,.8) 84%,transparent 100%);opacity:.04;mix-blend-mode:multiply;margin-left:-1.75px}
  .liquid-glass-lens[data-mode="title"] .liquid-glass-lens__scene--cyan{margin-left:2px}
  .liquid-glass-lens[data-mode="title"] .liquid-glass-lens__scene--warm{margin-left:-2px}
  .liquid-glass-lens__specular{position:absolute;inset:0;border-radius:inherit;background:linear-gradient(135deg,rgba(255,255,255,.14),transparent 18%,transparent 72%,rgba(37,70,96,.06));mask-image:radial-gradient(ellipse at center,transparent 70%,#000 100%);-webkit-mask-image:radial-gradient(ellipse at center,transparent 70%,#000 100%);pointer-events:none}
}

@media (max-width:1023px), (hover:none), (pointer:coarse), (prefers-reduced-motion:reduce){.liquid-glass-lens{display:none!important}}
