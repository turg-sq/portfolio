import { motion } from 'framer-motion'
import { Reveal, TitleReveal } from '../components/Reveal'
const goals = [['01', '趣味学习', '用可探索的内容，让学习自然发生。', 'wide'], ['02', 'IP陪伴', '温暖的熊猫伙伴，陪孩子每一步成长。', ''], ['03', '游戏反馈', '即时的鼓励，建立持续学习动力。', ''], ['04', '儿童友好', '更大、更清晰、更容易理解的界面。', 'tall']]
export default function DesignGoal() { return <section id="goals" className="goals section"><div className="content"><Reveal><p className="eyebrow">02 / DESIGN GOAL</p></Reveal><div className="goals-heading"><TitleReveal><h2>为成长设计<br />每一个小瞬间</h2></TitleReveal><Reveal delay={.12}><p>一套围绕儿童真实使用感受建立的体验原则。</p></Reveal></div><div className="goal-grid">{goals.map(([num, title, text, shape], index) => <motion.article key={num} className={`goal-card ${shape}`} initial={{ opacity: 0, y: 28 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, amount: .18 }} transition={{ delay: index * .09, duration: .55 }} whileHover={{ y: -8, rotate: index % 2 ? .7 : -.7 }}><span>{num}</span><h3>{title}</h3><p>{text}</p><i>{index === 0 ? '✦' : index === 1 ? '●' : index === 2 ? '↗' : '✓'}</i></motion.article>)}</div></div></section> }
