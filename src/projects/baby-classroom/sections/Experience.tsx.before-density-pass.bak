import { motion, useReducedMotion } from 'framer-motion'
import { useState } from 'react'
import MediaPreview from '../components/MediaPreview'
import { Reveal, TitleReveal } from '../components/Reveal'
const steps = [['学习入口', '从首页进入清晰的学习旅程。', '0%'], ['关卡路径', '用路径串联内容与连续探索。', '-18%'], ['任务节点', '在关键节点安排轻量任务反馈。', '-38%'], ['阶段反馈', '以可理解的视觉线索提示进度。', '-58%'], ['最终成长', '将每一次完成汇聚为成长记录。', '-78%']]
const screens = [['登录页', 'login.png'], ['首页', 'home.png'], ['答题页', 'quiz.png'], ['成长记录', 'profile.png']]

export default function Experience() { const [active, setActive] = useState(0); const [preview, setPreview] = useState<{ type: 'image'; src: string; title: string } | null>(null); const reduced = useReducedMotion(); const asset=(name:string)=>`/assets/projects/baby-classroom/images/${name}`
  return <section id="experience" className="experience section"><div className="content"><div className="experience-intro"><Reveal><p className="eyebrow">03 / APP EXPERIENCE</p></Reveal><TitleReveal><h2>探索式<br /><span>学习体验</span></h2></TitleReveal><p className="body-copy">从进入应用到完成一次学习，每个页面都保持轻松、清晰与积极的节奏。</p></div><div className="map-story"><div className="map-steps">{steps.map(([title, text], index) => <motion.article key={title} className={active === index ? 'active' : ''} onViewportEnter={() => setActive(index)} viewport={{ amount: .65 }}><span>0{index + 1}</span><h3>{title}</h3><p>{text}</p></motion.article>)}</div><div className="map-stage"><div className="map-phone"><motion.img src={asset('map.png')} alt="宝宝小课堂学习地图" animate={reduced ? { y: 0 } : { y: steps[active][2] }} transition={{ duration: .52, ease: [0.16, 1, .3, 1] }} /></div><button className="map-preview-button" type="button" onClick={() => setPreview({ type: 'image', src: asset('map.png'), title: '宝宝小课堂完整学习地图' })}>查看完整地图</button></div></div><div className="experience-screen-strip">{screens.map(([label, src]) => <figure key={label}><div><img src={asset(src)} alt={`宝宝小课堂${label}`} /></div><figcaption>{label}</figcaption></figure>)}</div></div><MediaPreview preview={preview} onClose={() => setPreview(null)} /></section> }
