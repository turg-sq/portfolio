import {useTexture} from '@react-three/drei'
import {useFrame,useThree} from '@react-three/fiber'
import {useEffect,useLayoutEffect,useMemo,useRef,useState} from 'react'
import * as THREE from 'three'
import {createCurvedPlaneGeometry,createMosaicTexture,setCurvedPlaneBend} from './curvedCard'
import {getCardState,helix} from './helix'
import {createRoundedAlphaMask} from './roundedMask'
import type {VisualSlot} from './spiralProjects'

export type HelixCardDebug={slotIndex:number;angle:number;targetPosition:[number,number,number];actualWorldPosition:[number,number,number];scale:number;opacity:number;brightness:number;saturation:number;focusStrength:number;frontness:number;facingDot:number;frontVisible:boolean;backVisible:boolean;finalRotationY:number;bendRadians:number;geometryUpdates:number;frontMaterialType:string;backMaterialType:string;mosaicWidth:number;isActive:boolean;targetScale:number;targetOpacity:number}

export default function SpiralCard({slot,getPhase,getActiveSlot,onDebug}:{slot:VisualSlot;getPhase:()=>number;getActiveSlot:()=>number;onDebug?:(value:HelixCardDebug)=>void}){
  const texture=useTexture(slot.cover) as THREE.Texture
  const {gl}=useThree()
  const group=useRef<THREE.Group>(null)
  const frontMesh=useRef<THREE.Mesh>(null)
  const backMesh=useRef<THREE.Mesh>(null)
  const front=useRef<THREE.MeshBasicMaterial>(null)
  const back=useRef<THREE.MeshBasicMaterial>(null)
  const initialized=useRef(false)
  const [hovered,setHovered]=useState(false)
  const baseArc=.12
  const geometry=useMemo(()=>createCurvedPlaneGeometry(helix.cardWidth,helix.cardWidth/slot.aspectRatio,64,8,baseArc),[slot.aspectRatio])
  const mask=useMemo(()=>createRoundedAlphaMask(slot.aspectRatio),[slot.aspectRatio])
  const mosaicWidth=128
  const mosaic=useMemo(()=>createMosaicTexture(texture.image as CanvasImageSource,slot.aspectRatio,mosaicWidth),[texture,slot.aspectRatio])
  const initial=useMemo(()=>getCardState(slot.slotIndex,0),[slot.slotIndex])
  const worldPosition=useMemo(()=>new THREE.Vector3(),[])
  const frontNormal=useMemo(()=>new THREE.Vector3(),[])
  const toCamera=useMemo(()=>new THREE.Vector3(),[])
  const worldQuaternion=useMemo(()=>new THREE.Quaternion(),[])
  const lastArc=useRef(baseArc)

  useEffect(()=>{texture.colorSpace=THREE.SRGBColorSpace;texture.magFilter=THREE.LinearFilter;texture.minFilter=THREE.LinearMipmapLinearFilter;texture.generateMipmaps=true;texture.wrapS=THREE.ClampToEdgeWrapping;texture.wrapT=THREE.ClampToEdgeWrapping;texture.anisotropy=Math.min(8,gl.capabilities.getMaxAnisotropy());texture.needsUpdate=true},[gl,texture])
  useEffect(()=>()=>{geometry.dispose();mask.dispose();mosaic.dispose()},[geometry,mask,mosaic])
  const apply=(card:ReturnType<typeof getCardState>,scale=card.scale,opacity=card.opacity)=>{if(group.current){group.current.position.copy(card.position);group.current.rotation.copy(card.rotation);group.current.scale.setScalar(scale)}if(front.current)front.current.opacity=opacity;if(back.current)back.current.opacity=opacity}
  useLayoutEffect(()=>{apply(initial)},[initial])

  useFrame((state,delta)=>{
    const target=getCardState(slot.slotIndex,getPhase())
    const isActive=slot.slotIndex===getActiveSlot()
    const angleDistance=Math.abs(target.angle)
    const verticalDistance=Math.abs(target.position.y)
    let targetScale=isActive?THREE.MathUtils.lerp(.88,1,target.focusStrength):Math.min(THREE.MathUtils.lerp(.7,.86,target.focusStrength),.86)
    let targetOpacity=isActive?THREE.MathUtils.lerp(.72,1,target.focusStrength):Math.min(THREE.MathUtils.lerp(.38,.68,target.focusStrength),.68)
    const targetBrightness=isActive?THREE.MathUtils.lerp(.86,1,target.focusStrength):Math.min(THREE.MathUtils.lerp(.68,.84,target.focusStrength),.84)
    if(!isActive&&angleDistance<.5&&verticalDistance<.65){targetScale*=.94;targetOpacity*=.6}
    const interactive=isActive&&target.focusStrength>.5
    const hoverFactor=hovered&&interactive?.96:1
    if(!initialized.current){apply(target,targetScale,targetOpacity);initialized.current=true;return}
    if(!group.current)return
    group.current.position.lerp(target.position,Math.min(1,delta*10))
    group.current.rotation.x=THREE.MathUtils.damp(group.current.rotation.x,target.rotation.x,12,delta)
    group.current.rotation.y=THREE.MathUtils.damp(group.current.rotation.y,target.rotation.y,12,delta)
    group.current.rotation.z=THREE.MathUtils.damp(group.current.rotation.z,target.rotation.z,12,delta)
    group.current.scale.setScalar(THREE.MathUtils.damp(group.current.scale.x,targetScale*hoverFactor,8,delta))
    group.current.updateWorldMatrix(true,false)
    group.current.getWorldPosition(worldPosition)
    frontNormal.set(0,0,1).applyQuaternion(group.current.getWorldQuaternion(worldQuaternion)).normalize()
    toCamera.copy(state.camera.position).sub(worldPosition).normalize()
    const facingDot=frontNormal.dot(toCamera)
    const sideFactor=1-Math.abs(facingDot)
    const finalArc=THREE.MathUtils.lerp(baseArc,THREE.MathUtils.degToRad(25),THREE.MathUtils.smoothstep(sideFactor,.28,.88))
    if(Math.abs(finalArc-lastArc.current)>.0005){setCurvedPlaneBend(geometry,helix.cardWidth,finalArc);lastArc.current=finalArc}
    if(frontMesh.current)frontMesh.current.visible=facingDot>=0
    if(backMesh.current)backMesh.current.visible=facingDot<0
    if(front.current)front.current.opacity=THREE.MathUtils.damp(front.current.opacity,targetOpacity,8,delta)
    if(back.current)back.current.opacity=THREE.MathUtils.damp(back.current.opacity,targetOpacity,8,delta)
    if(onDebug)onDebug({slotIndex:slot.slotIndex,angle:target.angle,targetPosition:target.position.toArray(),actualWorldPosition:worldPosition.toArray(),scale:group.current.scale.x,opacity:front.current?.opacity??targetOpacity,brightness:targetBrightness,saturation:1,focusStrength:target.focusStrength,frontness:target.frontness,facingDot,frontVisible:facingDot>=0,backVisible:facingDot<0,finalRotationY:target.rotation.y,bendRadians:lastArc.current,geometryUpdates:geometry.userData.bendUpdates??0,frontMaterialType:'MeshBasicMaterial',backMaterialType:'MeshBasicMaterial',mosaicWidth,isActive,targetScale,targetOpacity})
  })
  const allowHover=()=>getCardState(slot.slotIndex,getPhase()).focusStrength>.5
  return <group ref={group} position={initial.position} rotation={initial.rotation} scale={initial.scale} onPointerOver={event=>{if(allowHover()){event.stopPropagation();setHovered(true);document.body.style.cursor='pointer'}}} onPointerOut={()=>{setHovered(false);document.body.style.cursor='default'}}>
    <mesh ref={frontMesh} geometry={geometry} position={[0,0,.006]}><meshBasicMaterial ref={front} map={texture} alphaMap={mask} transparent alphaTest={.01} opacity={initial.opacity} depthWrite={false} toneMapped={false} side={THREE.FrontSide}/></mesh>
    <mesh ref={backMesh} geometry={geometry} rotation={[0,Math.PI,0]} position={[0,0,-.006]} visible={false}><meshBasicMaterial ref={back} map={mosaic} alphaMap={mask} transparent alphaTest={.01} opacity={initial.opacity} depthWrite={false} toneMapped={false} side={THREE.FrontSide}/></mesh>
  </group>
}
