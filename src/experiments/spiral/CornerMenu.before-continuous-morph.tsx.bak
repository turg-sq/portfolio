import {AnimatePresence,motion,useReducedMotion} from 'framer-motion'
import {useEffect,useRef,useState} from 'react'

type MenuBounds={width:number;height:number;top:number;right:number}

function getMenuBounds():MenuBounds{
  const mobile=window.innerWidth<768
  return mobile
    ? {width:window.innerWidth-24,height:window.innerHeight-24,top:12,right:12}
    : {width:Math.min(Math.max(460,window.innerWidth*.32),620),height:window.innerHeight-28,top:14,right:14}
}

export default function CornerMenu({onWorks}:{onWorks:()=>void}){
  const reduced=useReducedMotion()
  const triggerRef=useRef<HTMLButtonElement>(null)
  const surfaceRef=useRef<HTMLDivElement>(null)
  const closeTimer=useRef<number|null>(null)
  const collapseTimer=useRef<number|null>(null)
  const [surfaceOpen,setSurfaceOpen]=useState(false)
  const [contentVisible,setContentVisible]=useState(false)
  const [showTrigger,setShowTrigger]=useState(true)
  const [bounds,setBounds]=useState<MenuBounds>(()=>getMenuBounds())

  useEffect(()=>{
    const update=()=>setBounds(getMenuBounds())
    addEventListener('resize',update)
    return ()=>removeEventListener('resize',update)
  },[])
  useEffect(()=>()=>{if(closeTimer.current!==null)window.clearTimeout(closeTimer.current);if(collapseTimer.current!==null)window.clearTimeout(collapseTimer.current)},[])
  useEffect(()=>{
    const onKeyDown=(event:KeyboardEvent)=>{if(event.key==='Escape'&&surfaceOpen)closeMenu()}
    addEventListener('keydown',onKeyDown)
    return ()=>removeEventListener('keydown',onKeyDown)
  })
  useEffect(()=>{
    if(!surfaceOpen)return
    const getFocusable=()=>Array.from(surfaceRef.current?.querySelectorAll<HTMLElement>('button:not([disabled]),[href],input,select,textarea,[tabindex]:not([tabindex="-1"])')??[])
    const focusFirst=()=>getFocusable()[0]?.focus()
    requestAnimationFrame(focusFirst)
    const trapFocus=(event:KeyboardEvent)=>{
      if(event.key!=='Tab')return
      const items=getFocusable()
      if(!items.length)return
      const first=items[0],last=items[items.length-1]
      if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus()}
      else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus()}
    }
    addEventListener('keydown',trapFocus)
    return ()=>removeEventListener('keydown',trapFocus)
  },[surfaceOpen])

  const openMenu=()=>{
    if(closeTimer.current!==null){window.clearTimeout(closeTimer.current);closeTimer.current=null}
    if(collapseTimer.current!==null){window.clearTimeout(collapseTimer.current);collapseTimer.current=null}
    setShowTrigger(false)
    setSurfaceOpen(true)
    requestAnimationFrame(()=>setContentVisible(true))
  }
  const closeMenu=()=>{
    if(!surfaceOpen)return
    setContentVisible(false)
    if(closeTimer.current!==null)window.clearTimeout(closeTimer.current)
    closeTimer.current=window.setTimeout(()=>{
      setSurfaceOpen(false)
      closeTimer.current=null
      collapseTimer.current=window.setTimeout(()=>{
        setShowTrigger(true)
        collapseTimer.current=null
        requestAnimationFrame(()=>triggerRef.current?.focus())
      },reduced?10:520)
    },reduced?10:160)
  }
  const openWorks=()=>{onWorks();closeMenu()}
  const collapsed={width:132,height:58,borderRadius:999,top:24,right:24}
  const openTransition=reduced?{duration:.01}:{duration:.65,ease:[.76,0,.24,1] as const,times:[0,.46,1]}
  const closeTransition=reduced?{duration:.01}:{duration:.52,ease:[.76,0,.24,1] as const,times:[0,.58,1]}
  const surfaceAnimation=surfaceOpen
    ? {width:[132,132,bounds.width],height:[58,bounds.height,bounds.height],borderRadius:[999,15,15],top:[24,bounds.top,bounds.top],right:[24,bounds.right,bounds.right]}
    : {width:[bounds.width,132,132],height:[bounds.height,bounds.height,58],borderRadius:[15,15,999],top:[bounds.top,24,24],right:[bounds.right,24,24]}

  return <>
    <AnimatePresence>{!showTrigger&&<motion.button className="corner-menu-backdrop" type="button" aria-label="关闭菜单" onClick={closeMenu} initial={{opacity:0}} animate={{opacity:1}} exit={{opacity:0}} transition={{duration:reduced?.01:.18}}/>}</AnimatePresence>
    <motion.div
      ref={surfaceRef}
      className={`corner-menu-surface ${surfaceOpen?'is-open':'is-closed'}`}
      initial={collapsed}
      animate={surfaceAnimation}
      transition={surfaceOpen?openTransition:closeTransition}
      style={{transformOrigin:'top right'}}
      role={surfaceOpen?'dialog':undefined}
      aria-modal={surfaceOpen||undefined}
      aria-label={surfaceOpen?'网站菜单':undefined}
    >
      {showTrigger&&<button ref={triggerRef} className="menu-trigger" type="button" onClick={openMenu} aria-label="打开菜单" aria-expanded={false}><span>menu</span><span className="menu-trigger__dot"/></button>}
      <AnimatePresence>{contentVisible&&<motion.div className="corner-menu-content" initial={{opacity:0}} animate={{opacity:1}} exit={{opacity:0,x:18}} transition={{duration:reduced?.01:.16,ease:[.22,1,.36,1]}}>
        <div className="corner-menu-heading"><button type="button" className="corner-menu-close-text" onClick={closeMenu}>关闭</button><button type="button" className="menu-close-button" onClick={closeMenu} aria-label="关闭菜单">×</button></div>
        <nav className="menu-panel__nav" aria-label="菜单导航">
          <motion.button type="button" onClick={openWorks} initial={{opacity:0,y:28}} animate={{opacity:1,y:0}} transition={{delay:reduced?0:.42,duration:reduced?.01:.32,ease:[.22,1,.36,1]}}>作品</motion.button>
          <motion.button type="button" disabled aria-disabled="true" initial={{opacity:0,y:28}} animate={{opacity:1,y:0}} transition={{delay:reduced?0:.49,duration:reduced?.01:.32,ease:[.22,1,.36,1]}}>关于</motion.button>
          <motion.button type="button" disabled aria-disabled="true" initial={{opacity:0,y:28}} animate={{opacity:1,y:0}} transition={{delay:reduced?0:.56,duration:reduced?.01:.32,ease:[.22,1,.36,1]}}>联系方式</motion.button>
        </nav>
        <motion.div className="corner-menu-footer" initial={{opacity:0,y:14}} animate={{opacity:1,y:0}} transition={{delay:reduced?0:.64,duration:reduced?.01:.28,ease:[.22,1,.36,1]}}><span>你的邮箱地址</span></motion.div>
      </motion.div>}</AnimatePresence>
    </motion.div>
  </>
}
