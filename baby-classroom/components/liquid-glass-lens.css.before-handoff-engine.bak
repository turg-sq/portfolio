.liquid-glass-lens{display:none}

@media (min-width:1024px) and (hover:hover) and (pointer:fine){
  .liquid-glass-lens{position:absolute;z-index:8;inset:0;display:block;overflow:hidden;pointer-events:none;opacity:0;transition:opacity .16s ease-out}
  .liquid-glass-lens[data-active="true"]{opacity:1}
  .liquid-glass-lens[data-mode="blank"]{opacity:.42}
  .liquid-glass-lens[data-mode="visual"]{opacity:.68}
  .liquid-glass-lens[data-mode="title"]{opacity:.8}
  .liquid-glass-lens__defs{position:absolute;width:0;height:0;overflow:hidden}
  .liquid-glass-lens__body{position:absolute;left:0;top:0;width:clamp(330px,18.2vw,350px);height:clamp(200px,11.2vw,215px);overflow:hidden;border-radius:54% 46% 50% 50% / 48% 51% 46% 55%;background:rgba(255,255,255,.012);box-shadow:6px 10px 23px rgba(33,73,99,.105),-1px -1px 10px rgba(255,255,255,.07),inset 9px 8px 15px rgba(255,255,255,.035),inset -10px -10px 16px rgba(30,59,82,.055);will-change:transform}
  .liquid-glass-lens__body:before{content:'';position:absolute;z-index:5;inset:0;border-radius:inherit;background:radial-gradient(ellipse 76% 34% at 23% 15%,rgba(255,255,255,.1),rgba(255,255,255,.035) 34%,transparent 72%),radial-gradient(ellipse 22% 18% at 84% 25%,rgba(255,255,255,.105),transparent 73%),radial-gradient(ellipse 105% 94% at 76% 84%,transparent 65%,rgba(27,54,76,.07) 94%,transparent 100%);pointer-events:none}
  .liquid-glass-lens__body:after{content:'';position:absolute;z-index:6;right:7%;bottom:3%;left:8%;height:15%;border-radius:50%;background:radial-gradient(ellipse at center,rgba(222,248,255,.065),transparent 72%);pointer-events:none}
  .liquid-glass-lens__scene{position:absolute;inset:0;width:max-content;height:max-content;will-change:transform;pointer-events:none}
  .liquid-glass-lens__scene>.hero{position:relative;min-height:100%;overflow:hidden;pointer-events:none}
  .liquid-glass-lens__scene--edge{mask-image:radial-gradient(ellipse at center,transparent 0 35%,rgba(0,0,0,.1) 52%,rgba(0,0,0,.56) 68%,#000 82%,rgba(0,0,0,.9) 94%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse at center,transparent 0 35%,rgba(0,0,0,.1) 52%,rgba(0,0,0,.56) 68%,#000 82%,rgba(0,0,0,.9) 94%,transparent 100%);opacity:.74}
  .liquid-glass-lens__scene--cyan{mask-image:radial-gradient(ellipse at 22% 48%,transparent 0 67%,rgba(0,0,0,.92) 86%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse at 22% 48%,transparent 0 67%,rgba(0,0,0,.92) 86%,transparent 100%);opacity:.125;mix-blend-mode:screen;margin-left:2.25px}
  .liquid-glass-lens__scene--warm{mask-image:radial-gradient(ellipse at 78% 60%,transparent 0 67%,rgba(0,0,0,.92) 86%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse at 78% 60%,transparent 0 67%,rgba(0,0,0,.92) 86%,transparent 100%);opacity:.09;mix-blend-mode:multiply;margin-left:-2.25px}
  .liquid-glass-lens[data-mode="title"] .liquid-glass-lens__scene--cyan{margin-left:3px;opacity:.16}
  .liquid-glass-lens[data-mode="title"] .liquid-glass-lens__scene--warm{margin-left:-3px;opacity:.12}
  .liquid-glass-lens__specular{position:absolute;z-index:7;display:block;border-radius:50%;pointer-events:none}
  .liquid-glass-lens__specular--primary{top:8%;left:10%;width:42%;height:22%;background:radial-gradient(ellipse at center,rgba(255,255,255,.12),rgba(255,255,255,.045) 39%,transparent 72%);transform:rotate(-13deg)}
  .liquid-glass-lens__specular--secondary{top:17%;right:11%;width:19%;height:14%;background:radial-gradient(ellipse at center,rgba(255,255,255,.1),transparent 70%);transform:rotate(18deg)}
  .liquid-glass-lens__caustic{position:absolute;z-index:7;right:14%;bottom:5%;width:32%;height:7%;border-radius:50%;background:radial-gradient(ellipse at center,rgba(221,248,255,.06),transparent 74%);transform:rotate(-8deg);pointer-events:none}
}

@media (max-width:1023px), (hover:none), (pointer:coarse), (prefers-reduced-motion:reduce){.liquid-glass-lens{display:none!important}}
