import {motion,useReducedMotion,useScroll,useTransform} from 'framer-motion'
import {useEffect,useRef} from 'react'
import './butterfly-journey.css'

const galleryImages=[
  '01-tool-flow.png',
  '02-nail-trends.png',
  '03-main-visual.png',
  '04-products.png',
  '05-application.png',
  '06-exhibition.png',
]

const captions=[
  ['03.1 / TOOL EVOLUTION','美甲工具的演化'],
  ['03.2 / CURRENT NAIL ART TRENDS','当代美甲趋势'],
  ['04.1 / VISUAL SYSTEM','信息可视化主视觉'],
  ['04.2 / PRODUCT APPLICATION','产品与应用延展'],
  ['05.1 / APPLICATION','展陈与传播场景'],
]

const ease=[.22,1,.36,1] as const

export default function ButterflyJourneyPage({onBack}:{onBack:()=>void}){
  const reducedMotion=useReducedMotion()
  const pageRef=useRef<HTMLElement>(null)
  const {scrollY}=useScroll({container:pageRef})
  const copyY=useTransform(scrollY,[0,640],[0,-30])
  const visualY=useTransform(scrollY,[0,640],[0,-10])
  const indexY=useTransform(scrollY,[0,640],[0,20])

  useEffect(()=>{
    window.scrollTo({top:0,behavior:'instant'})
  },[])

  return <main ref={pageRef} className="butterfly-journey-page">
    <motion.button className="butterfly-journey-page__back" type="button" onClick={onBack} initial={reducedMotion?false:{opacity:0}} animate={{opacity:1}} transition={{duration:.32,delay:.04,ease}}><span aria-hidden="true">←</span> 返回作品</motion.button>

    <section className="butterfly-journey-page__hero" aria-labelledby="butterfly-journey-title">
      <motion.span className="butterfly-journey-page__hero-number" aria-hidden="true" style={reducedMotion?undefined:{y:indexY}}>03</motion.span>
      <motion.div className="butterfly-journey-page__hero-copy" initial={reducedMotion?false:{opacity:0,y:16}} animate={{opacity:1,y:0}} transition={{duration:.6,delay:.12,ease}} style={reducedMotion?undefined:{y:copyY}}>
        <p className="butterfly-journey-page__index">03 / 06</p>
        <span className="butterfly-journey-page__category">DATA VISUALIZATION · 2026</span>
        <h1 id="butterfly-journey-title">《蝶变<br />之旅》</h1>
        <strong>美甲信息可视化设计</strong>
        <div className="butterfly-journey-page__guide" aria-label="项目视觉关键词"><i /><span>TOOL FLOW</span><span>VISUAL SYSTEM</span><span>BEAUTY CULTURE</span></div>
      </motion.div>

      <motion.figure className="butterfly-journey-page__hero-visual" initial={reducedMotion?false:{opacity:0,y:70,scale:1.025}} animate={{opacity:1,y:0,scale:1}} transition={{duration:.76,delay:.34,ease}} style={reducedMotion?undefined:{y:visualY}}>
        <img src={`/assets/projects/butterfly-journey/gallery/${galleryImages[0]}`} alt="《蝶变之旅》美甲工具流程信息可视化主视觉" />
      </motion.figure>

      <nav className="butterfly-journey-page__chapter-index" aria-label="章节索引">
        {['01  RESEARCH','02  CONTEXT','03  TOOL FLOW','04  VISUAL SYSTEM','05  APPLICATION','06  SUMMARY'].map((item)=>{
          const active=item.startsWith('03')
          return <span className={active?'is-active':''} key={item}>{item}{active&&<i />}</span>
        })}
      </nav>
    </section>

    <section className="butterfly-journey-page__gallery" aria-label="《蝶变之旅》作品图集">
      {galleryImages.slice(1).map((image,index)=>{
        const [eyebrow,title]=captions[index]
        return <motion.figure className={`butterfly-journey-page__gallery-item is-item-${index+2}`} key={image} initial={reducedMotion?false:{opacity:0,y:30,scale:.99}} whileInView={{opacity:1,y:0,scale:1}} viewport={{once:true,amount:.12}} transition={{duration:.58,delay:reducedMotion?0:Math.min(index*.06,.24),ease}}>
          <img src={`/assets/projects/butterfly-journey/gallery/${image}`} alt={`《蝶变之旅》${title}`} loading="lazy" />
          <figcaption><span>{eyebrow}</span><strong>{title}</strong></figcaption>
        </motion.figure>
      })}
    </section>
  </main>
}
