import * as THREE from 'three'
export function createRoundedAlphaMask(aspect:number){const width=256,height=Math.max(96,Math.round(width/aspect)),radius=Math.min(30,height*.22);const canvas=document.createElement('canvas');canvas.width=width;canvas.height=height;const context=canvas.getContext('2d')!;context.fillStyle='#fff';context.beginPath();context.roundRect(0,0,width,height,radius);context.fill();const texture=new THREE.CanvasTexture(canvas);texture.colorSpace=THREE.NoColorSpace;texture.needsUpdate=true;return texture}
