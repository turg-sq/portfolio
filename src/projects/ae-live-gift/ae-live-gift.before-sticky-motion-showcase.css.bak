.ae-live-gift-page{--ae-ink:#241d29;--ae-muted:#716877;--ae-rose:#dc4187;--ae-orange:#f18e4f;--ae-violet:#8260ca;position:fixed;z-index:20;inset:0;overflow:auto;background:#faf8f7;color:var(--ae-ink);font-family:var(--font-body-cn)}.ae-live-gift-page *{box-sizing:border-box}.ae-live-gift-page__back{position:fixed;z-index:200;top:24px;left:24px;display:inline-flex;align-items:center;gap:9px;min-height:46px;padding:0 18px;border:0;border-radius:999px;background:rgba(23,20,25,.9);color:#fff;font:600 15px/1 var(--font-body-cn);cursor:pointer;backdrop-filter:blur(10px);transition:background .18s ease-out,transform .18s ease-out}.ae-live-gift-page__back>span{transition:transform .18s ease-out}.ae-live-gift-page__back:hover{background:#332e36}.ae-live-gift-page__back:hover>span{transform:translateX(-2px)}.ae-live-gift-page__back:active{transform:scale(.97)}.ae-live-gift-page__back:focus-visible{outline:3px solid rgba(220,65,135,.55);outline-offset:4px}.ae-gift-hero,.ae-gift-section{width:min(1280px,calc(100% - 96px));margin:0 auto}.ae-gift-hero{min-height:88vh;display:grid;grid-template-columns:minmax(0,.9fr) minmax(340px,.7fr);align-items:center;gap:clamp(48px,9vw,140px);padding:112px 0 76px}.ae-gift-eyebrow,.ae-section-heading>span,.ae-section-heading p{display:block;margin:0;color:var(--ae-violet);font:700 12px/1.2 var(--font-body-cn);letter-spacing:.14em}.ae-gift-hero h1{max-width:600px;margin:24px 0 0;font-family:var(--font-display-cn);font-size:clamp(58px,8vw,122px);font-weight:400;line-height:.95;letter-spacing:-.05em}.ae-gift-hero__meta{margin:24px 0 0;color:var(--ae-muted);font-size:16px}.ae-gift-hero__description{max-width:590px;margin:32px 0 0;font-size:18px;line-height:1.85}.ae-gift-hero__media{padding:18px;border-radius:15px;background:linear-gradient(145deg,#241c2a,#4a2244);box-shadow:0 24px 60px rgba(221,65,132,.1)}.ae-gift-hero__media img{display:block;width:100%;height:auto;object-fit:contain;border-radius:8px}.ae-gift-section{padding-block:96px}.ae-section-heading{display:grid;grid-template-columns:84px minmax(0,1fr);gap:28px;margin-bottom:54px}.ae-section-heading h2{margin:12px 0 0;font-family:var(--font-display-cn);font-size:clamp(42px,5vw,76px);font-weight:400;line-height:1;letter-spacing:-.04em}.ae-gift-goals{max-width:none;width:100%;padding-inline:max(48px,calc((100vw - 1280px)/2));background:#f2eff1}.ae-gift-goals .ae-section-heading,.ae-gift-goal-grid{max-width:1280px;margin-left:auto;margin-right:auto}.ae-gift-goal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.ae-gift-goal-card{position:relative;min-height:280px;padding:28px;border-radius:15px;overflow:hidden}.ae-gift-goal-card>span{font:700 12px/1 var(--font-body-cn);letter-spacing:.12em}.ae-gift-goal-card h3{margin:52px 0 0;font-family:var(--font-display-cn);font-size:32px;font-weight:400}.ae-gift-goal-card p{max-width:295px;margin:17px 0 0;line-height:1.75}.ae-gift-goal-card i{position:absolute;right:25px;bottom:24px;width:48px;border-top:1px solid currentColor}.ae-gift-goal-card.is-rose{background:#fae8ef;color:#853354}.ae-gift-goal-card.is-orange{background:#fceadc;color:#89502a}.ae-gift-goal-card.is-violet{background:#ede8f8;color:#514276}.ae-gift-process{background:#fff}.ae-gift-process-track{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0}.ae-gift-process-track article{position:relative;min-height:230px;padding:20px 25px 24px;border-top:2px solid #d9d4db}.ae-gift-process-track article:first-child{border-color:var(--ae-rose)}.ae-gift-process-track article:not(:last-child):after{content:'';position:absolute;top:-1px;right:0;width:1px;height:60%;background:#ded9de}.ae-gift-process-track span,.ae-gift-visual-rules span{color:var(--ae-violet);font:700 12px/1 var(--font-body-cn);letter-spacing:.12em}.ae-gift-process-track h3{margin:42px 0 0;font-family:var(--font-display-cn);font-size:25px;font-weight:400}.ae-gift-process-track p{margin:14px 0 0;color:var(--ae-muted);line-height:1.7}.ae-gift-visual-system{max-width:none;width:100%;padding-inline:max(48px,calc((100vw - 1280px)/2));background:#f7edef}.ae-gift-visual-system .ae-section-heading,.ae-gift-visual-grid{max-width:1280px;margin-left:auto;margin-right:auto}.ae-gift-visual-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(45px,8vw,130px)}.ae-gift-panel-label{margin:0 0 16px;color:var(--ae-muted);font-size:13px;letter-spacing:.1em}.ae-gift-swatches{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:46px}.ae-gift-swatches span{display:grid;min-height:132px;align-content:end;padding:14px;border-radius:15px;color:#fff;font:600 14px/1 var(--font-body-cn)}.ae-gift-swatches .is-rose{background:var(--ae-rose)}.ae-gift-swatches .is-orange{background:var(--ae-orange)}.ae-gift-swatches .is-violet{background:var(--ae-violet)}.ae-gift-support-colors{display:flex;gap:10px}.ae-gift-support-colors span{padding:10px 13px;border-radius:999px;background:#fff;font-size:13px}.ae-gift-support-colors span:nth-child(2){background:#423c46;color:#fff}.ae-gift-support-colors span:nth-child(3){background:rgba(23,20,25,.68);color:#fff}.ae-gift-visual-rules{display:grid;gap:0}.ae-gift-visual-rules article{display:grid;grid-template-columns:58px minmax(0,1fr);gap:17px;padding:21px 0;border-top:1px solid rgba(44,36,44,.14)}.ae-gift-visual-rules h3{margin:0;font-family:var(--font-display-cn);font-size:24px;font-weight:400}.ae-gift-visual-rules p{margin:7px 0 0;color:var(--ae-muted);line-height:1.7}.ae-gift-motion-showcase{max-width:none;width:100%;padding-inline:max(48px,calc((100vw - 1280px)/2));background:#171419;color:#f8f1f6}.ae-gift-motion-showcase .ae-section-heading,.ae-gift-motion-layout{max-width:1280px;margin-left:auto;margin-right:auto}.ae-section-heading.is-inverse>span,.ae-section-heading.is-inverse p{color:#d5b2ce}.ae-gift-motion-layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:24px}.ae-motion-preview{margin:0;padding:18px;border-radius:15px;background:#211d23;overflow:hidden;box-shadow:0 24px 60px rgba(221,65,132,.1)}.ae-motion-preview figcaption{display:flex;justify-content:space-between;gap:12px;padding:2px 2px 15px;color:#cbbac8;font:700 11px/1 var(--font-body-cn);letter-spacing:.12em}.ae-motion-preview img{display:block;width:100%;height:auto;object-fit:contain;border-radius:8px}.ae-motion-preview>p{margin:15px 2px 2px;color:#f3e7ef;font-size:14px;line-height:1.5}.ae-gift-motion-pair{display:grid;gap:24px}.ae-motion-preview.is-wide{grid-column:1 / -1}.ae-gift-summary{padding-bottom:110px}.ae-gift-summary>p{max-width:680px;margin:0 0 0 112px;color:var(--ae-muted);font-size:17px;line-height:1.8}.ae-gift-next{display:grid;gap:10px;width:100%;border:0;padding:clamp(54px,8vw,120px) max(48px,calc((100vw - 1280px)/2));background:#241d29;color:#fff;text-align:left;cursor:pointer}.ae-gift-next span{color:#c8bac4;font-size:12px;letter-spacing:.12em}.ae-gift-next strong{font-family:var(--font-display-cn);font-size:clamp(34px,5vw,76px);font-weight:400;line-height:1;letter-spacing:-.04em}@media(max-width:767px){.ae-live-gift-page__back{top:max(14px,env(safe-area-inset-top));left:14px;min-height:44px;padding:0 16px}.ae-gift-hero,.ae-gift-section{width:calc(100% - 40px)}.ae-gift-hero{min-height:auto;grid-template-columns:1fr;gap:42px;padding:104px 0 64px}.ae-gift-hero h1{font-size:clamp(50px,15vw,70px)}.ae-gift-hero__description{font-size:16px}.ae-gift-section{padding-block:64px}.ae-section-heading{grid-template-columns:1fr;gap:13px;margin-bottom:34px}.ae-section-heading h2{font-size:44px}.ae-gift-goals,.ae-gift-visual-system,.ae-gift-motion-showcase{padding-inline:20px}.ae-gift-goal-grid,.ae-gift-process-track,.ae-gift-visual-grid,.ae-gift-motion-layout{grid-template-columns:1fr}.ae-gift-goal-card{min-height:220px}.ae-gift-process-track{gap:16px}.ae-gift-process-track article{min-height:0;padding:20px 0;border-top:2px solid #d9d4db}.ae-gift-process-track article:not(:last-child):after{display:none}.ae-gift-visual-grid{gap:44px}.ae-gift-swatches span{min-height:96px}.ae-gift-motion-pair{gap:16px}.ae-motion-preview{padding:12px}.ae-motion-preview.is-wide{grid-column:auto}.ae-gift-summary>p{margin-left:0;font-size:16px}.ae-gift-next{padding:64px 20px}}
