export type ViewMode='spiral'|'list'

function FlipTextButton({label,active,onClick}:{label:string;active:boolean;onClick:()=>void}){
  return <button type="button" aria-label={label} aria-pressed={active} className={`flip-text-button ${active?'is-active':''}`} onClick={onClick}>
    <span className="flip-text-viewport">
      <span className="flip-text-sizer" aria-hidden="true">{label}</span>
      <span className="flip-text-layer flip-text-current">{label}</span>
      <span className="flip-text-layer flip-text-next" aria-hidden="true">{label}</span>
    </span>
  </button>
}

export default function ViewSwitcher({viewMode,onChange}:{viewMode:ViewMode;onChange:(mode:ViewMode)=>void}){
  return <nav className="spiral-view-switcher" aria-label="作品浏览视图">
    <FlipTextButton label="螺旋" active={viewMode==='spiral'} onClick={()=>onChange('spiral')}/>
    <span className="spiral-view-switcher-dot" aria-hidden="true"/>
    <FlipTextButton label="列表" active={viewMode==='list'} onClick={()=>onChange('list')}/>
  </nav>
}
